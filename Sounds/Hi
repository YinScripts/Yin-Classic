        local gui = Panel.Gui
        if not (gui and gui.Parent) or not Panel.Open then return end
        Panel.Open = false
        local shade, scale = gui:FindFirstChild("Shade"), gui:FindFirstChild("Shade") and gui.Shade:FindFirstChild("Card") and gui.Shade.Card:FindFirstChildOfClass("UIScale")
