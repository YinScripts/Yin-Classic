        chip.Button.Visible = chip.Mode == AC.Mode
        chip.Button.BackgroundColor3 = active and pal().Accent or pal().Secondary
        chip.Button.BackgroundTransparency = active and 0.05 or 0.45
        chip.Label.TextColor3 = active and AvatarContrastColor(pal().Accent) or pal().Text
    end
    for key, tab in pairs(W.Tabs) do
        local active = key == AC.Mode
        tab.Button.BackgroundColor3 = active and pal().Accent or pal().Background
        tab.Button.BackgroundTransparency = active and 0 or 1
        tab.Label.TextColor3 = active and AvatarContrastColor(pal().Accent) or pal().TextDim
    end
    for key, chip in pairs(W.SkinChips) do
        local active = key == AC.SkinTarget
        chip.BackgroundColor3 = active and pal().Accent or pal().Secondary
        chip.BackgroundTransparency = active and 0.05 or 0.45
        chip.TextColor3 = active and AvatarContrastColor(pal().Accent) or pal().Text
    end
end

