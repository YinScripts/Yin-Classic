-- ===== GANCHO DE AGARRE (Grapple Hook / Grapple Shot) · primero en la pestaña Extra =====
-- Verificado en el código del juego (to_nick.zip):
--   · Tirón: ReplicatedStorage.Objects.Game.ToolProfile.ViewmodelVisuals.Types.Grapple (cliente) clona su hijo
--     "SpringConstraint" en cada enganche y lo une a HumanoidRootPart.VelPos → se modifica la PLANTILLA
--     (sin require: también sirve en Solara). Al apagar se devuelven los valores originales.
--   · Alcance: el servidor manda Speed 470 · Lifetime 0.12 y TU cliente simula el tiro en
--     GenericImpulse.Types.Assets.Projectile (pasos de 0.2 s → 470 × 0.2 = 94 studs por paso). Con Lifetime 0.12
--     el tiro hace UN solo paso y muere. El enganche y el tirón salen de esa simulación local (el servidor no crea
--     el proyectil), así que subir el Lifetime que recibe TU cliente le da más pasos = más alcance.
--     Eso necesita require → no se usa en Solara (allí require crea copias y puede matar al personaje).
--   · Pared invisible: el tiro solo engancha en partes con Transparency ~= 1 y CanCollide ~= false, fuera de
--     workspace.Effects / Players / Rigs. Si delante no hay nada dentro del alcance, se mantiene una pared local
--     casi invisible justo antes del límite para que el tiro se agarre ahí.
-- Funcion global (no local) por el limite de 200 registros del chunk principal.
function setupGrappleSection()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local isSolara = false
    pcall(function()
        if identifyexecutor then
            isSolara = string.find(string.lower(tostring(identifyexecutor())), "solara", 1, true) ~= nil
        end
    end)

    local STEP = 94          -- studs por paso de simulación (470 × 0.2)
    local WALL_MARGIN = 10   -- la pared queda 10 studs antes del límite (el servidor puede verte unos studs atrás)
    local G = { Enabled = false, Pull = 100, Damp = 100, Orig = nil, Range = STEP }
    local PROPS = { "Stiffness", "Damping", "FreeLength", "MaxForce" }

    -- estado compartido con el envoltorio de Projectile.new (sobrevive a re-ejecutar el script)
    env.YYGrappleRange = env.YYGrappleRange or { Steps = 1, Hooked = false }
    local RangeCfg = env.YYGrappleRange
    RangeCfg.Steps = 1

    local function template()
        local ok, spring = pcall(function()
            return ReplicatedStorage.Objects.Game.ToolProfile.ViewmodelVisuals.Types.Grapple:FindFirstChild("SpringConstraint")
        end)
        if ok and spring and spring:IsA("SpringConstraint") then return spring end
        return nil
    end

    local function setLabel(label, es, en)
        if not label then return end
        pcall(function()
            label:SetAttribute("TextSpanish", es)
            label:SetAttribute("TextEnglish", en)
            label.Text = scriptText(es, en)
        end)
    end

    TabExtra:CreateLabel("GANCHO DE AGARRE", "GRAPPLE HOOK", 14)
    TabExtra:CreateDivider()
    local infoLabel = TabExtra:CreateLabel("Gancho original: esperando partida…", "Original grapple: waiting for a match…", 11)

    local function showOriginal()
        local o = G.Orig
        if not (o and o.Stiffness and o.Damping) then return end
        setLabel(infoLabel,
            string.format("Gancho original · fuerza %.0f · amortiguación %.0f · alcance %d studs", o.Stiffness, o.Damping, STEP),
            string.format("Original grapple · pull %.0f · damping %.0f · range %d studs", o.Stiffness, o.Damping, STEP))
    end

    local function readOriginal(spring)
        if G.Orig then return end
        G.Orig = {}
        for _, prop in ipairs(PROPS) do
            local ok, value = pcall(function() return spring[prop] end)
            if ok then G.Orig[prop] = value end
        end
        showOriginal()
    end

    local function apply()
        local spring = template()
        if not spring then return false end
        readOriginal(spring)
        local o = G.Orig
        pcall(function()
            if G.Enabled then
                spring.Stiffness = o.Stiffness * G.Pull / 100
                spring.Damping = o.Damping * G.Damp / 100
                -- si el resorte tiene un tope de fuerza, sube junto con la fuerza del tirón
                if o.MaxForce and o.MaxForce < math.huge then
                    spring.MaxForce = o.MaxForce * math.max(1, G.Pull / 100)
                end
            else
                for _, prop in ipairs(PROPS) do
                    if o[prop] ~= nil then spring[prop] = o[prop] end
                end
            end
        end)
        return true
    end

    -- ---------- ALCANCE (envoltorio de Projectile.new, solo fuera de Solara) ----------
    local function installRangeHook()
        if RangeCfg.Hooked then return true end
        if isSolara then return false end
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Services.Shared.GenericImpulse.Types.Assets.Projectile)
        end)
        if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then
            warn("[Gancho] No se pudo leer GenericImpulse.Types.Assets.Projectile: " .. tostring(mod))
            return false
        end
        -- el original se guarda en getgenv para no envolver dos veces si el script se ejecuta de nuevo
        local original = env.YYGrappleProjectileNew or mod.new
        env.YYGrappleProjectileNew = original
        mod.new = function(data, ...)
            if type(data) == "table" then
                local cfg = env.YYGrappleRange
                local steps = cfg and tonumber(cfg.Steps) or 1
                if steps > 1 then
                    local proj = data.Projectile
                    local isGrapple = proj == "Grapple" or (typeof(proj) == "Instance" and proj.Name == "Grapple")
                    if isGrapple and data.Creator ~= nil and data.Creator == LocalPlayer.Character then
                        -- el bucle corta cuando el tiempo pasado >= Lifetime, revisado después de cada paso de 0.2 s
                        data.Lifetime = steps * 0.2 - 0.1
                    end
                end
            end
            return original(data, ...)
        end
        RangeCfg.Hooked = true
        return true
    end

    local function rangeSteps()
        return math.max(1, math.floor(G.Range / STEP + 0.5))
    end

    local rangeLabel
    local function updateRange()
        local steps = rangeSteps()
        if G.Enabled and steps > 1 and not isSolara then
            installRangeHook()
        end
        RangeCfg.Steps = (G.Enabled and RangeCfg.Hooked) and steps or 1
        if isSolara then
            setLabel(rangeLabel, "Alcance: en Solara queda el original (" .. STEP .. " studs)",
                "Range: Solara keeps the original (" .. STEP .. " studs)")
        elseif not G.Enabled then
            setLabel(rangeLabel, "Alcance: original (" .. STEP .. " studs) · activá Mejorar gancho",
                "Range: original (" .. STEP .. " studs) · turn on Boost grapple")
        else
            setLabel(rangeLabel, "Alcance real: " .. (RangeCfg.Steps * STEP) .. " studs",
                "Actual range: " .. (RangeCfg.Steps * STEP) .. " studs")
        end
    end

    local boostToggle
    boostToggle = TabExtra:CreateToggle("Mejorar gancho", "Boost grapple", false, function(enabled)
        G.Enabled = enabled
        if not apply() and enabled then
            warn("[Gancho] No se encontró la plantilla del gancho (ReplicatedStorage.Objects.Game.ToolProfile.ViewmodelVisuals.Types.Grapple.SpringConstraint)")
            G.Enabled = false
            if boostToggle and boostToggle.SetValue then boostToggle.SetValue(false) end
        end
        updateRange()
    end)
    TabExtra:CreateSlider("Fuerza del tirón %", 25, 600, 100, function(value)
        G.Pull = tonumber(value) or 100
        if G.Enabled then apply() end
    end)
