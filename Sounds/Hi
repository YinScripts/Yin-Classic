-- Aplica una HumanoidDescription al rig visual. En R15, Evade mueve los Motor6D del rig a una carpeta
-- "Joints" (RigService.CreateCachedRig): ApplyDescriptionReset reconstruye las partes del cuerpo y ahi
-- puede fallar. Si falla, se usa ApplyDescription, que solo cambia lo distinto (accesorios, ropa, colores).
-- Devuelve ok, mensajeDeError.
function AvatarApplyDescriptionSafe(humanoid, description)
    -- R15 de Evade (verificado con R15 Rig Scan, 2026-10-12): el rig visual NO tiene HumanoidRootPart.
    -- Evade lo une al personaje real con rig.Joints.Root (Part0 = Workspace.Players.<jugador>.HumanoidRootPart),
    -- y Roblox rechaza ApplyDescription con "Humanoid has no HumanoidRootPart". Se pone una raíz TEMPORAL
    -- (invisible, sin colisión, sin masa, sin anclar) solo mientras se aplica, y después se borra.
    local rig = humanoid and humanoid.Parent
    if rig and not rig:FindFirstChild("HumanoidRootPart") then
        local tempRoot = Instance.new("Part")
        tempRoot.Name = "HumanoidRootPart"
        tempRoot.Size = Vector3.new(2, 2, 1)
        tempRoot.Transparency = 1
        tempRoot.CanCollide, tempRoot.CanQuery, tempRoot.CanTouch = false, false, false
        tempRoot.Massless = true
        tempRoot.Anchored = false
        local reference = nil
        pcall(function()
            local joints = rig:FindFirstChild("Joints")
            local rootJoint = joints and joints:FindFirstChild("Root")
            if rootJoint and rootJoint.Part0 and rootJoint.Part0:IsDescendantOf(workspace) then reference = rootJoint.Part0 end
        end)
        reference = reference or rig:FindFirstChild("LowerTorso") or rig:FindFirstChild("Torso")
        if reference then tempRoot.CFrame = reference.CFrame end
        tempRoot.Parent = rig
        -- solo ApplyDescription (cambia lo distinto): ApplyDescriptionReset reconstruye todo el cuerpo
        local okDiff, errDiff = pcall(function()
            humanoid:ApplyDescription(description)
        end)
        pcall(function() tempRoot:Destroy() end)
        pcall(AvatarRepairRigJoints, rig)
        if okDiff then
            return true, nil
        end
        warn("[Avatar] R15 sin HumanoidRootPart · ApplyDescription:", errDiff)
        return false, tostring(errDiff)
    end

    local okReset, errReset = pcall(function()
        humanoid:ApplyDescriptionReset(description)
    end)
    if okReset then
        return true, nil
    end
    local okDiff, errDiff = pcall(function()
        humanoid:ApplyDescription(description)
    end)
    if okDiff then
        warn("[Avatar] ApplyDescriptionReset fallo, se uso ApplyDescription:", errReset)
        return true, nil
    end
    warn("[Avatar] ApplyDescriptionReset:", errReset, "| ApplyDescription:", errDiff)
    return false, tostring(errDiff or errReset)
end

-- Si ApplyDescription cambió alguna parte del cuerpo (cabeza, torso, brazos, piernas), las articulaciones de
-- rig.Joints quedan apuntando a la parte vieja. Se reconectan a la parte nueva con el mismo nombre.
-- Las que apuntan al personaje real (Joints.Root → Workspace.Players.<jugador>.HumanoidRootPart) no se tocan.
function AvatarRepairRigJoints(rig)
    local joints = rig and rig:FindFirstChild("Joints")
    if not joints then return end
    for _, joint in ipairs(joints:GetDescendants()) do
        if joint:IsA("JointInstance") then
            for _, key in ipairs({ "Part0", "Part1" }) do
                local part = joint[key]
                if part and not part:IsDescendantOf(workspace) then
                    local replacement = rig:FindFirstChild(part.Name)
                    if replacement and replacement:IsA("BasePart") then
                        joint[key] = replacement
                    end
                end
            end
        end
    end
end

-- Texto corto del error para mostrar en la interfaz (sin la ruta del script)
function AvatarShortError(err)
    local text = tostring(err or "")
    text = text:gsub("^[^:]*:%d+: ", "")
    if #text > 70 then
        text = text:sub(1, 67) .. "..."
    end
    return text
end

function ApplyAvatarByUsername()
    local username = tostring(AvatarUsernameInput.Text or ""):match("^%s*(.-)%s*$")
    if username == "" then
        SetAvatarStatus("Escribe un nombre de usuario.", "Enter a username.", Color3.fromRGB(255, 135, 135))
        return
    end

    local visualRig, visualHumanoid = GetAvatarVisualHumanoid()
    if not visualRig or not visualHumanoid then
        SetAvatarStatus("No se encontró el rig visual (entrá a una partida).", "The visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
        return
    end
    -- R6 y R15: Evade pone los dos en Workspace.Rigs.<jugador> (RigService); se aplica con AvatarApplyDescriptionSafe

    SetAvatarStatus("Cargando avatar de " .. username .. "...", "Loading " .. username .. "'s avatar...", Color3.fromRGB(195, 215, 255))
    local okUser, userIdOrError = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if not okUser then
        SetAvatarStatus("No se encontró ese usuario.", "That user was not found.", Color3.fromRGB(255, 135, 135))
        return
    end

    local okDescription, descriptionOrError = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(userIdOrError)
    end)
    if not okDescription then
        SetAvatarStatus("No se pudo cargar el avatar.", "The avatar could not be loaded.", Color3.fromRGB(255, 135, 135))
        return
    end

    local okApply, applyError = AvatarApplyDescriptionSafe(visualHumanoid, descriptionOrError)
    if not okApply then
        SetAvatarStatus("No se pudo aplicar el avatar: " .. AvatarShortError(applyError),
            "The avatar could not be applied: " .. AvatarShortError(applyError), Color3.fromRGB(255, 135, 135))
        return
    end

    SetAvatarStatus(
        "Avatar de " .. username .. " aplicado. Escribe otro nombre para cambiarlo.",
        username .. "'s avatar was applied. Enter another name to change it.",
        Color3.fromRGB(145, 255, 180)
    )
end

