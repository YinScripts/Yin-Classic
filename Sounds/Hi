    function W.ClampWindow()
        local screen = W.ScreenGui.AbsoluteSize
        local size = W.Overlay.Size
        local maxX = screen.X - 120
        if maxX < 0 then maxX = 0 end
        local maxY = screen.Y - 60
        if maxY < 0 then maxY = 0 end
        local minX = -size.X.Offset + 120
        if minX > maxX then minX = maxX end
        local x = math.clamp(W.Overlay.Position.X.Offset, minX, maxX)
        local y = math.clamp(W.Overlay.Position.Y.Offset, 0, maxY)
        W.Overlay.Position = UDim2.fromOffset(x, y)
    end
