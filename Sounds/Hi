-- ===== Yin Yang Goat v3 (aterrizaje asistido, planeo temprano) =====
-- Apenas empiezas a caer predice DONDE vas a aterrizar (posicion + velocidad horizontal x tiempo de caida)
-- y busca el objeto PEQUENO mas cercano a ese punto (cactus, etc.; ignora pisos y casas grandes).
-- Te acerca de a poco por frame, repartido en el tiempo que falta para el impacto, con limite de velocidad lateral.
-- Solo toca la POSICION (CFrame): nunca escribe la velocidad, asi que Dara Trimp y Goat no se pisan.
-- Toggle "Goat: apuntar con camara": en vez del mas cercano, elige el objeto que esta mas alineado con donde apunta la camara.
do
    local GoatRange = 6                 -- studs (slider): radio horizontal de busqueda alrededor del punto de aterrizaje previsto
    local GoatConnection = nil
    local GoatCameraMode = false        -- toggle: elegir objetivo segun la camara
    local GoatJump = false              -- toggle "Jump": al tocar el objeto al que Goat te mando, saltas
    local GoatJumpHeight = 15           -- studs (slider): altura del salto al tocar ese objeto

    local MIN_FALL_SPEED = 3            -- studs/s hacia abajo para considerar que estas cayendo
    local EARLY_FINISH = 0.05           -- s antes del impacto en que la correccion ya termino
    local RESEARCH_INTERVAL = 0.15      -- s entre busquedas de objetivo
    local MAX_CANDIDATES = 25           -- partes que se revisan por busqueda
    local SWITCH_MARGIN = 2             -- studs de mejora necesarios para cambiar de objetivo (evita saltos)
    local SMALL_MAX = 12                -- studs: lado horizontal maximo para considerar un objeto "pequeno"
    local MAX_LATERAL_SPEED = 40        -- studs/s: maximo que Goat te mueve de lado (evita tirones)
    local MAX_PREDICT_TIME = 2          -- s: tope del tiempo de caida usado para predecir el aterrizaje
    local JUMP_REAPPLY_TIME = 0.06      -- s (~3-4 frames): tiempo en que se re-aplica la velocidad del salto de Goat (para que un auto-salto no la pise)

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    pcall(function() overlapParams.RespectCanCollide = true end)
    pcall(function() rayParams.RespectCanCollide = true end)

    local lockedPart = nil              -- parte objetivo
    local lockedLocal = nil             -- punto de aterrizaje en espacio local de esa parte
    local lastSearch = 0
    local feetOffset = nil              -- distancia root -> planta de los pies
    local wasFalling = false
    local lastErr = nil
    local jumpPart = nil                -- ultimo objeto al que Goat te mando (para el salto del toggle Jump)
    local justJumped = false            -- true si el ultimo aterrizaje fue seguido de un salto de Goat (evita rebote infinito)
    local jumpBoostVy = 0               -- velocidad vertical inicial del ultimo salto de Goat
    local jumpBoostStart = 0            -- os.clock() del ultimo salto de Goat
    local jumpBoostUntil = 0            -- os.clock() hasta el que se re-aplica (0 = inactivo)

    local function partTopY(part)
        local cf, s = part.CFrame, part.Size
        local ext = 0.5 * (math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z)
        return cf.Position.Y + ext
    end

    local function computeFeetOffset(character, root)
        local lowest = math.huge
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("BasePart") then
                local bottom = 2 * child.Position.Y - partTopY(child)
                if bottom < lowest then lowest = bottom end
            end
        end
        if lowest == math.huge then return nil end
        return root.Position.Y - lowest
    end

    -- lado horizontal (X, Z del mundo) de la caja que envuelve la parte
    local function partHorizontalSize(part)
        local cf, s = part.CFrame, part.Size
        local ex = math.abs(cf.RightVector.X) * s.X + math.abs(cf.UpVector.X) * s.Y + math.abs(cf.LookVector.X) * s.Z
        local ez = math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z
        return ex, ez
    end

    -- tiempo (s) para caer una distancia d con velocidad de caida speed (studs/s, positiva)
    local function fallTime(speed, d)
        local g = Workspace.Gravity
        if g > 0 then
            return (-speed + math.sqrt(speed * speed + 2 * g * d)) / g
        end
        return d / math.max(speed, 0.001)
    end

    -- direccion horizontal de la camara (nil si miras casi recto arriba/abajo)
    local function cameraFlatLook()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.05 then return nil end
        return flat.Unit
    end

    -- puntaje de un punto (menor = mejor): distancia al punto de aterrizaje previsto,
    -- o en modo camara, distancia perpendicular al rayo de la camara (solo hacia adelante)
    local function scorePoint(p, landing, pos, camLook)
        if GoatCameraMode and camLook then
            local rel = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z)
            local along = rel:Dot(camLook)
            if along < 0 then return nil end
            return (rel - camLook * along).Magnitude
        end
        return Vector3.new(p.X - landing.X, 0, p.Z - landing.Z).Magnitude
    end

    local function findTarget(character, root, feetY, vel, camLook)
        local pos = root.Position
        local bottomY = math.max(Workspace.FallenPartsDestroyHeight, feetY - 5000)
        local height = (feetY - 0.5) - bottomY
        if height <= 1 then return nil end

        rayParams.FilterDescendantsInstances = { character }
        overlapParams.FilterDescendantsInstances = { character }

        -- prediccion: tiempo hasta el suelo que hay debajo y punto horizontal donde caerias
        local groundHit = Workspace:Raycast(pos, Vector3.new(0, -(pos.Y - bottomY), 0), rayParams)
        local dGround = feetY - (groundHit and groundHit.Position.Y or bottomY)
        local tEst = math.min(fallTime(math.max(-vel.Y, 0), math.max(dGround, 0)), MAX_PREDICT_TIME)
        local landing = Vector3.new(pos.X + vel.X * tEst, 0, pos.Z + vel.Z * tEst)

        local parts = Workspace:GetPartBoundsInBox(
            CFrame.new(landing.X, bottomY + height * 0.5, landing.Z),
            Vector3.new(GoatRange * 2, height, GoatRange * 2),
            overlapParams
        )

        local list = {}
        for _, part in ipairs(parts) do
            if part.CanCollide and part.Transparency < 1 then
                local ex, ez = partHorizontalSize(part)
                if math.max(ex, ez) <= SMALL_MAX and partTopY(part) < feetY - 0.25 then
                    local model = part:FindFirstAncestorOfClass("Model")
                    if not (model and model:FindFirstChildOfClass("Humanoid")) then
                        local score = scorePoint(part.Position, landing, pos, camLook)
                        if score then
                            list[#list + 1] = { part = part, score = score }
                        end
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.score < b.score end)

        local down = Vector3.new(0, -(pos.Y - bottomY), 0)
        local checked = 0
        for _, c in ipairs(list) do
            if checked >= MAX_CANDIDATES then break end
            checked = checked + 1
            local p = c.part.Position
            local hit = Workspace:Raycast(Vector3.new(p.X, pos.Y, p.Z), down, rayParams)
            -- el objeto mismo tiene que ser lo que se toca desde arriba (no un piso mas grande)
            if hit and hit.Instance == c.part and hit.Normal.Y > 0.3 and hit.Position.Y < feetY - 0.25 then
                return {
                    part = c.part,
                    localPoint = c.part.CFrame:PointToObjectSpace(hit.Position),
                    score = scorePoint(hit.Position, landing, pos, camLook) or c.score,
                }
            end
        end
        return nil
    end

    local function goatStep(dt)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not (humanoid and root) or humanoid.Health <= 0 or humanoid.SeatPart then
            lockedPart = nil
            wasFalling = false
            return
        end

        -- salto de Goat: durante unos frames se mantiene la velocidad vertical que corresponde a la altura elegida
        -- (siguiendo la gravedad), para que otro salto automatico (ej. Jump Aceleracion) no la pise
        if jumpBoostUntil > 0 then
            local jnow = os.clock()
            if jnow >= jumpBoostUntil then
                jumpBoostUntil = 0
            else
                local jv = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(jv.X, jumpBoostVy - Workspace.Gravity * (jnow - jumpBoostStart), jv.Z)
            end
        end

        local vel = root.AssemblyLinearVelocity
        local falling = vel.Y <= -MIN_FALL_SPEED and humanoid.FloorMaterial == Enum.Material.Air
        if not falling then
            -- aterrizaje: si toco el objeto al que Goat me mando y el toggle Jump esta activo, salta
            if wasFalling and humanoid.FloorMaterial ~= Enum.Material.Air then
                local part = jumpPart
                local allow = not justJumped
                justJumped = false
                jumpPart = nil
                local g = Workspace.Gravity
                if GoatJump and allow and part and feetOffset and g > 0 then
                    rayParams.FilterDescendantsInstances = { character }
                    local touching = false
                    local hit = Workspace:Raycast(root.Position, Vector3.new(0, -(feetOffset + 2), 0), rayParams)
                    if hit and hit.Instance == part then
                        touching = true
                    end
                    if not touching then
                        -- contacto por caja bajo los pies: el rayo solo ve una linea fina y puede pasar al lado del objeto
                        overlapParams.FilterDescendantsInstances = { character }
                        local rp = root.Position
                        local near = Workspace:GetPartBoundsInBox(
                            CFrame.new(rp.X, rp.Y - feetOffset - 0.25, rp.Z),
                            Vector3.new(5, 3.5, 5),
                            overlapParams
                        )
                        for _, p in ipairs(near) do
                            if p == part then
                                touching = true
                                break
                            end
                        end
                    end
                    if touching then
                        local jumpVy = math.sqrt(2 * g * GoatJumpHeight)
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                        root.AssemblyLinearVelocity = Vector3.new(vel.X, jumpVy, vel.Z)
                        justJumped = true
                        jumpBoostVy = jumpVy
                        jumpBoostStart = os.clock()
                        jumpBoostUntil = jumpBoostStart + JUMP_REAPPLY_TIME
                    end
                end
            end
            lockedPart = nil
            wasFalling = false
            return
        end

        if not wasFalling then
            wasFalling = true
            feetOffset = computeFeetOffset(character, root)
            lastSearch = 0
            lockedPart = nil
            jumpPart = nil
        end
        if not feetOffset then return end

        local pos = root.Position
        local feetY = pos.Y - feetOffset
        local camLook = cameraFlatLook()

        local now = os.clock()
        if now - lastSearch >= RESEARCH_INTERVAL then
            lastSearch = now
            local found = findTarget(character, root, feetY, vel, camLook)
            if found then
                if lockedPart and lockedPart.Parent and found.part ~= lockedPart then
                    -- solo cambia de objetivo si el nuevo es claramente mejor que el actual
                    local lockedWorld = lockedPart.CFrame:PointToWorldSpace(lockedLocal)
                    local tEst = math.min(fallTime(-vel.Y, math.max(feetY - lockedWorld.Y, 0)), MAX_PREDICT_TIME)
                    local landing = Vector3.new(pos.X + vel.X * tEst, 0, pos.Z + vel.Z * tEst)
                    local lockedScore = scorePoint(lockedWorld, landing, pos, camLook)
                    if (not lockedScore) or found.score < lockedScore - SWITCH_MARGIN then
                        lockedPart, lockedLocal = found.part, found.localPoint
                    end
                else
                    lockedPart, lockedLocal = found.part, found.localPoint
                end
            elseif not (lockedPart and lockedPart.Parent) then
                lockedPart = nil
            end
        end

        if not (lockedPart and lockedPart.Parent) then
            lockedPart = nil
            return
        end
        jumpPart = lockedPart

        local target = lockedPart.CFrame:PointToWorldSpace(lockedLocal)
        local d = feetY - target.Y
        if d <= 0.1 then
            lockedPart = nil
            return
        end

        local t = fallTime(-vel.Y, d)
        -- punto horizontal donde caerias si no corrigiera nada (incluye la velocidad de Trimp)
        local landingX = pos.X + vel.X * t
        local landingZ = pos.Z + vel.Z * t
        local offset = Vector3.new(target.X - landingX, 0, target.Z - landingZ)
        local mag = offset.Magnitude
        if mag < 0.02 then return end
        if mag > GoatRange * 1.5 then
            lockedPart = nil
            return
        end

        local frac = math.clamp(dt / math.max(t - EARLY_FINISH, dt), 0, 1)
        local step = offset * frac
        local maxStep = MAX_LATERAL_SPEED * dt
        if step.Magnitude > maxStep then
            step = step.Unit * maxStep
        end

        root.CFrame = root.CFrame + step
    end

    TabMove:CreateFloatingToggle(
        "Fall Beta",
        "Fall Beta",
        false,
        function(enabled)
            if GoatConnection then
                GoatConnection:Disconnect()
                GoatConnection = nil
            end
            lockedPart = nil
            wasFalling = false
            if enabled then
                GoatConnection = RunService.Heartbeat:Connect(function(dt)
                    local ok, err = pcall(goatStep, dt)
                    if not ok and tostring(err) ~= lastErr then
                        lastErr = tostring(err)
                        warn("[Yin Yang Goat] " .. lastErr)
                    end
                end)
            end
        end
    )

    TabMove:CreateSlider(
        "Goat Range (studs)",
        1, 100, GoatRange,
        function(value)
            local n = tonumber(value)
            if n and n > 0 then
                GoatRange = n
            end
        end
    )

    TabMove:CreateSlider(
        "Jump Height (studs)",
        1, 100, GoatJumpHeight,
        function(value)
            local n = tonumber(value)
            if n and n > 0 then
                GoatJumpHeight = n
            end
        end
    )

    TabMove:CreateToggle(
        "Goat: apuntar con cámara",
        "Goat: aim with camera",
        false,
        function(enabled)
            GoatCameraMode = enabled
            lockedPart = nil
        end
    )

    TabMove:CreateToggle(
        "Jump",
        "Jump",
        false,
        function(enabled)
            GoatJump = enabled
        end
    )
    TabMove:CreateDivider()
end

-- ===== Do not fall (suelo invisible) =====
-- Al activarlo guarda la altura de tus pies en ese momento y mantiene un piso invisible a esa altura,
-- siguiendote en X/Z, sin importar el lugar. Al apagarlo el piso se elimina. La altura se guarda al activar:
-- si reapareces con el toggle encendido, apagalo y encendelo de nuevo para fijar la nueva altura.
do
    local FLOOR_SIZE = 14               -- studs: lado del piso invisible (cuadrado)
    local FLOOR_THICKNESS = 1           -- studs: grosor del piso
    local floorConnection = nil
    local floorPart = nil
    local floorY = nil                  -- altura (Y) de la superficie del piso
    local floorErr = nil

    local function destroyFloor()
        if floorConnection then
            floorConnection:Disconnect()
            floorConnection = nil
        end
        if floorPart then
            floorPart:Destroy()
            floorPart = nil
        end
        floorY = nil
    end

    -- distancia del root a la planta de los pies (parte mas baja del personaje)
    local function floorFeetOffset(character, root)
        local lowest = math.huge
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("BasePart") then
                local bottom = child.Position.Y - child.Size.Y * 0.5
                if bottom < lowest then lowest = bottom end
            end
        end
        if lowest == math.huge then return 3 end
        return root.Position.Y - lowest
    end

    local function floorStep()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if not floorY then
            floorY = root.Position.Y - floorFeetOffset(character, root)
        end
        if not (floorPart and floorPart.Parent) then
            floorPart = Instance.new("Part")
            floorPart.Name = "YY_DoNotFallFloor"
            floorPart.Anchored = true
            floorPart.CanCollide = true
            floorPart.CanTouch = false
            floorPart.CanQuery = false
            floorPart.Transparency = 1
            floorPart.CastShadow = false
            floorPart.Size = Vector3.new(FLOOR_SIZE, FLOOR_THICKNESS, FLOOR_SIZE)
            floorPart.Parent = Workspace
        end
        floorPart.CFrame = CFrame.new(root.Position.X, floorY - FLOOR_THICKNESS * 0.5, root.Position.Z)
    end

    TabMove:CreateFloatingToggle(
        "Do not fall",
        "Do not fall",
        false,
        function(enabled)
            destroyFloor()
            if enabled then
                floorConnection = RunService.Heartbeat:Connect(function()
                    local ok, err = pcall(floorStep)
                    if not ok and tostring(err) ~= floorErr then
                        floorErr = tostring(err)
                        warn("[Do not fall] " .. floorErr)
                    end
                end)
            end
        end
    )
    TabMove:CreateDivider()
end

