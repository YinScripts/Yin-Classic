-- aplica una descripcion al rig visual (mismo metodo que "Aplicar avatar")
local function applyDescription(desc, es, en)
    local humanoid = getVisualHumanoid()
    if not humanoid then
        setStatus("No se encontró tu rig visual (entrá a una partida).", "Your visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
        return false
    end
    AC.Busy = true
    setStatus("Aplicando...", "Applying...", Color3.fromRGB(195, 215, 255))
    local ok, err = AvatarApplyDescriptionSafe(humanoid, desc)
    AC.Busy = false
    if not ok then
        setStatus("No se pudo aplicar: " .. AvatarShortError(err), "Could not apply: " .. AvatarShortError(err), Color3.fromRGB(255, 135, 135))
        return false
    end
    setStatus(es, en, Color3.fromRGB(145, 255, 180))
    refreshPreview()
    task.delay(0.8, function()
        if W.Overlay and W.Overlay.Visible and not AC.Busy then
            refreshPreview()
        end
    end)
    if AC.Mode == "worn" then
        renderWorn()
    else
        refreshTiles()
    end
    return true
end

local function toggleLayered(id, assetType, name)
    if not isR15() then
        setStatus("La ropa 3D (en capas) solo funciona con avatar R15.", "3D (layered) clothing only works on R15 avatars.", Color3.fromRGB(255, 190, 120))
        return
    end
    local desc = currentDescription()
    if not desc then
        setStatus("No se encontró tu rig visual (entrá a una partida).", "Your visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
        return
    end
    local list = layeredList(desc)
    local removed = false
    for i = #list, 1, -1 do
        if tostring(list[i].AssetId) == tostring(id) then
            table.remove(list, i)
            removed = true
        end
    end
    if not removed then
        local okType, accessoryType = pcall(function() return Enum.AccessoryType[LAYERED[assetType]] end)
        if not okType or not accessoryType then
            setStatus("Ese tipo de ropa no está disponible.", "That clothing type is not available.", Color3.fromRGB(255, 190, 120))
            return
        end
        list[#list + 1] = { AssetId = tonumber(id), AccessoryType = accessoryType, IsLayered = true, Order = #list + 1 }
    end
    local okSet, err = pcall(function() desc:SetAccessories(list, false) end)
    if not okSet then
        setStatus("No se pudo poner esa ropa.", "Could not wear that clothing.", Color3.fromRGB(255, 135, 135))
        warn("[Catálogo] SetAccessories:", err)
        return
    end
    task.spawn(applyDescription, desc,
        (removed and "Quitado: " or "Puesto: ") .. tostring(name),
        (removed and "Removed: " or "Equipped: ") .. tostring(name))
end

local function toggleAsset(id, assetType, name)
    if AC.Busy then return end
    if LAYERED[assetType] then
        toggleLayered(id, assetType, name or id)
        return
    end
    local map = ASSET_PROPS[assetType]
    if not map then
        setStatus("Ese tipo de objeto no se puede usar en tu avatar.", "That item type can't be used on your avatar.", Color3.fromRGB(255, 190, 120))
        return
    end
    local desc = currentDescription()
    if not desc then
        setStatus("No se encontró tu rig visual (entrá a una partida).", "Your visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
        return
    end
    id = tostring(id)
    name = tostring(name or id)
    local removed
    if map[2] then
        local list = idList(desc[map[1]])
        local index = table.find(list, id)
        if index then
            table.remove(list, index)
        else
            list[#list + 1] = id
        end
        removed = index ~= nil
        desc[map[1]] = table.concat(list, ",")
    else
        removed = tonumber(desc[map[1]]) == tonumber(id)
        desc[map[1]] = removed and 0 or tonumber(id)
    end
    task.spawn(applyDescription, desc,
        (removed and "Quitado: " or "Puesto: ") .. name,
        (removed and "Removed: " or "Equipped: ") .. name)
end

-- paquete de cuerpo: se leen sus partes (BundledItems) y se ponen todas
local function applyBundle(item, onlyParts)
    if AC.Busy then return end
    setStatus("Leyendo el paquete...", "Reading the package...", Color3.fromRGB(195, 215, 255))
    task.spawn(function()
        local ok, details = pcall(function()
            local hasAsync = pcall(function() return AvatarEditorService.GetItemDetailsAsync end)
            if hasAsync then
                return AvatarEditorService:GetItemDetailsAsync(item.Id, Enum.AvatarItemType.Bundle)
            end
            return AvatarEditorService:GetItemDetails(item.Id, Enum.AvatarItemType.Bundle)
        end)
        if not ok or type(details) ~= "table" or type(details.BundledItems) ~= "table" then
            setStatus("No se pudo leer el paquete.", "Could not read the package.", Color3.fromRGB(255, 135, 135))
            return
        end
        local desc = currentDescription()
        if not desc then
            setStatus("No se encontró tu rig visual (entrá a una partida).", "Your visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
            return
        end
        local applied = 0
        local r15 = isR15()
        for _, part in ipairs(details.BundledItems) do
            local partType = assetTypeName(part.AssetType)
            -- en R15 la cabeza dinamica (DynamicHead) se pone en la propiedad Head
            if r15 and partType == "DynamicHead" then
                partType = "Head"
            end
            if part.Type == "Asset" and partType and table.find(onlyParts or BODY_PARTS, partType) then
                desc[partType] = tonumber(part.Id)
                applied += 1
            end
        end
        if applied == 0 then
            setStatus("Ese paquete no trae esa parte. Probá otro.", "That package doesn't include that part. Try another.", Color3.fromRGB(255, 190, 120))
            return
        end
        applyDescription(desc, "Paquete puesto: " .. tostring(item.Name), "Package equipped: " .. tostring(item.Name))
    end)
end

