function allUnequip(candidate)
    local entry = AllEquipped[candidate.module]
    if not entry then return end
    if entry.clone then
        pcall(function() entry.clone:Destroy() end)
    end
    AllEquipped[candidate.module] = nil
    AllEquippedCount = math.max(0, AllEquippedCount - 1)
end

-- Tocar una tarjeta: si estaba equipado se quita, si no se agrega (se pueden tener varios a la vez)
function allTestCandidate(candidate)
    if AllEquipped[candidate.module] then
        allUnequip(candidate)
        allSetStatus(candidate.name .. " quitado • " .. tostring(AllEquippedCount) .. " equipados")
    else
        local clone, err = allBuildVisual(candidate)
        if not clone then
            allSetStatus(err)
            return
        end
        AllEquipped[candidate.module] = { candidate = candidate, clone = clone }
        AllEquippedCount = AllEquippedCount + 1
        AllCurrentRoot = allGetContainer()
        allSetStatus(candidate.name .. " equipado • " .. tostring(AllEquippedCount) .. " equipados")
    end
    if AllUI.Filter == "equipped" then
        AllUI.Dirty = true
        allRebuildRows()
    else
        allRefreshCards()
    end
end

-- Si el rig visual se vuelve a crear (respawn), se re-equipa todo lo que estaba puesto
function allReequipAll()
    for module, entry in pairs(AllEquipped) do
        if entry.clone then
            pcall(function() entry.clone:Destroy() end)
        end
        local clone = allBuildVisual(entry.candidate)
        if clone then
            entry.clone = clone
        else
            AllEquipped[module] = nil
            AllEquippedCount = math.max(0, AllEquippedCount - 1)
        end
    end
    allRefreshCards()
end

