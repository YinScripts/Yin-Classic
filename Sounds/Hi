function disconnectEmoteConnections(list)
    for _, connection in ipairs(list) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(list)
end

local emoteModuleCache = {}
function buildEmoteCache()
    local items = ReplicatedStorage:FindFirstChild("Items")
    if not items then return end

    local roots = {}
    local packs = items:FindFirstChild("ItemPacks")
    if packs then table.insert(roots, packs) end
    local baseItems = items:FindFirstChild("BaseItems")
    if baseItems then table.insert(roots, baseItems) end

    -- Optimizacion: antes se hacia un GetDescendants() completo de cada raiz POR CADA emote.
    -- Ahora cada raiz se recorre una sola vez y se indexan los ModuleScript por nombre, guardando
    -- su posicion para respetar el mismo orden de busqueda (misma raiz primero, primer resultado).
    local indexByRoot = {}
    for r, root in ipairs(roots) do
        local byName = {}
        for i, inst in ipairs(root:GetDescendants()) do
            if inst.ClassName == "ModuleScript" then
                local list = byName[inst.Name]
                if not list then
                    list = {}
                    byName[inst.Name] = list
                end
                list[#list + 1] = { i, inst }
            end
        end
        indexByRoot[r] = byName
    end

    for _, emote in ipairs(EMOTES) do
        local acceptedNames = { emote.emoteName }
        if emote.emoteName == "Broom" then
            acceptedNames[#acceptedNames + 1] = "BroomOfDoom"
            acceptedNames[#acceptedNames + 1] = "Broom of Doom"
        end

        for r = 1, #roots do
            local candidates = {}
            for _, name in ipairs(acceptedNames) do
                for _, entry in ipairs(indexByRoot[r][name] or {}) do
                    candidates[#candidates + 1] = entry
                end
            end
            if #acceptedNames > 1 then
                table.sort(candidates, function(a, b) return a[1] < b[1] end)
            end
            local found = false
            for _, entry in ipairs(candidates) do
                local inst = entry[2]
                local hasEmoteModel = emote.emoteName == "Broom" and (inst:FindFirstChild("CharacterClassic", true)
                    or inst:FindFirstChild("EmoteModel", true))
                if emote.emoteName ~= "Broom" or hasEmoteModel then
                    emoteModuleCache[emote.emoteKey or emote.emoteName] = inst
                    found = true
                    break
                end
            end
            if found then break end
        end
    end

    if not emoteModuleCache.Broom then
        for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
            if inst.ClassName == "ModuleScript"
            and (inst.Name == "Broom" or inst.Name == "BroomOfDoom" or inst.Name == "Broom of Doom") then
                local hasEmoteModel = inst:FindFirstChild("CharacterClassic", true)
                    or inst:FindFirstChild("EmoteModel", true)
                if hasEmoteModel then
                    emoteModuleCache.Broom = inst
                    break
                end
            end
        end
    end
end

