        local look = prof.look or {}
        local cos = count(look.cosmetics)
        local hasBoom = type(look.cosmetics) == "table" and look.cosmetics.BoomboxSlot ~= nil
        if hasBoom then
            cos -= 1
        end
        local partsEs, partsEn = {}, {}
        local function add(es, en)
            partsEs[#partsEs + 1] = es
            partsEn[#partsEn + 1] = en
        end
        local e, sk = count(look.emotes), count(look.skins)
        if e > 0 then add(e .. " emotes", e .. " emotes") end
        if cos > 0 then add(cos .. " cosm.", cos .. " cosm.") end
        if sk > 0 then add(sk .. " skins", sk .. " skins") end
        if hasBoom then add("boombox", "boombox") end
        if count(prof.hud) > 0 or (type(prof.anim) == "table" and prof.anim.mode ~= "off") then add("HUD", "HUD") end
        if #partsEs == 0 then
            return "Vacío", "Empty"
        end
        return table.concat(partsEs, " · "), table.concat(partsEn, " · ")
    end

