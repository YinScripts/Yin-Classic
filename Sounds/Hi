-- ===== SPYDER BETA (portado de Spider_v2): trepar paredes y caminar por ellas =====
TabExtra:CreateLabel("SPYDER BETA", "SPYDER BETA", 14)
TabExtra:CreateDivider()

do
    local GENVS = getgenv()
    if GENVS.YY_Spyder and GENVS.YY_Spyder.Destroy then pcall(GENVS.YY_Spyder.Destroy) end
    local LP = LocalPlayer

    -- ===== AJUSTES =====
    local CFG = {
        Speed = Config.SpyderSpeed or 28,        -- velocidad sobre la pared (studs/s)
        AttachDist = 3.5,  -- distancia maxima al muro para engancharse
        Hover = Config.SpyderHover or 2.75,      -- distancia HRP-pared (igual a HRP-suelo medido: 2.75)
        MinIntent = 8,     -- velocidad minima pedida para engancharse
        MinDot = 0.5,      -- cuanto debe apuntar hacia el muro (0..1)
        MaxWallY = 0.25,   -- |normal.Y| maximo para contar como pared
        RotAlpha = Config.SpyderRotAlpha or 0.35,   -- suavidad del giro (0..1, mayor = mas rapido)
        JumpOff = 40,      -- impulso al soltarse con salto
        LostGrace = 0.15,  -- segundos sin pared antes de soltarse
        MantleOut = 10,    -- empuje hacia el otro lado al llegar arriba
        MantleUp = 14,
        Corners = false,   -- experimental: pasar de pared a pared/techo (toggle, no se guarda)
    }

    -- log a consola (F9), sin ventana propia
    local function log(msg)
        print("[Spyder] " .. tostring(msg))
    end

    local function v3(v)
        return string.format("(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    end

    -- con Corners: tambien cuentan techos/voladizos (normal hacia abajo); nunca suelos
    local function okNormal(n)
        if CFG.Corners then return n.Y <= CFG.MaxWallY end
        return math.abs(n.Y) <= CFG.MaxWallY
    end

    -- ============================================================ estado
    local enabled, attached = false, false
    local hooked = false
    local Movement, oldUpdate, myUpdate = nil, nil, nil
    local lv, att = nil, nil
    local baseMover, baseWasEnabled = nil, nil
    local normal, lookDir, lastNormal = nil, nil, nil
    local dist = 0
    local lostSince = nil
    local lastChar, lastHrp = nil, nil
    local jumpWasHeld = false
    local moving = false
    local lastCorner = -10
    local lastDbg = 0
    local lastWritten, lastDiag = nil, 0
    local errSeen = {}
    local fallbackParams = nil
    local setSpider -- se define mas abajo
    local spyderToggle

    local function getBase(self)
        local ok, bm = pcall(function() return self.Constraints.Constraints.BaseMover end)
        if ok and typeof(bm) == "Instance" then return bm end
        return nil
    end

    local function getParams(self, char)
        local ok, p = pcall(function() return self.Terms.WallrunParams end)
        if ok and typeof(p) == "RaycastParams" then return p end
        if not fallbackParams then
            fallbackParams = RaycastParams.new()
            pcall(function() fallbackParams.FilterType = Enum.RaycastFilterType.Exclude end)
        end
        fallbackParams.FilterDescendantsInstances = { char }
        return fallbackParams
    end

    -- ============================================================ soltar / enganchar
    local function detach(reason, hrp, pushVel)
        if not attached then return end
        attached = false
        if lv then pcall(function() lv:Destroy() end) lv = nil end
        if att then pcall(function() att:Destroy() end) att = nil end
        if baseMover and baseWasEnabled ~= nil then
            pcall(function() baseMover.Enabled = baseWasEnabled end)
        end
        baseMover, baseWasEnabled = nil, nil
        if hrp and hrp.Parent then
            pcall(function()
                local pos = hrp.Position
                local n = lastNormal or Vector3.new(1, 0, 0)
                local flat = Vector3.new(-n.X, 0, -n.Z)
                if flat.Magnitude < 0.05 then flat = Vector3.new(1, 0, 0) end
                hrp.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                if pushVel then hrp.AssemblyLinearVelocity = pushVel end
            end)
        end
        lostSince = nil
        log("SOLTADO: " .. reason)
    end

    local function attach(self, hrp, res)
        local bm = getBase(self)
        if not bm then log("No encuentro BaseMover, no me engancho") return false end
        baseMover = bm
        baseWasEnabled = bm.Enabled
        att = Instance.new("Attachment")
        att.Name = "SpiderAtt"
        att.Parent = hrp
        lv = Instance.new("LinearVelocity")
        lv.Name = "SpiderLV"
        lv.Attachment0 = att
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        lv.MaxForce = 1000000
        lv.VectorVelocity = Vector3.new(0, 0, 0)
        lv.Parent = hrp
        normal = res.Normal
        lastNormal = normal
        dist = (res.Position - hrp.Position).Magnitude
        local up = Vector3.new(0, 1, 0)
        local tu = up - normal * up:Dot(normal)
        lookDir = (tu.Magnitude > 0.05) and tu.Unit or Vector3.new(0, 1, 0)
        lostSince = nil
        lastWritten = nil
        moving = false
        attached = true
        log("ENGANCHADO a '" .. tostring(res.Instance and res.Instance.Name) .. "' normal=" .. v3(normal) .. " dist=" .. string.format("%.2f", dist))
        return true
    end

    -- ============================================================ paso por frame (despues de Movement.Update)
    local function step(self)
        local char = self.Character
        if not enabled or char ~= LP.Character then return end
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if char ~= lastChar then
            if attached then detach("cambio de personaje", nil) end
            lastChar = char
        end
        lastHrp = hrp
        if not (hrp and hum) or hum.Health <= 0 then
            if attached then detach("sin personaje/vida", hrp) end
            return
        end

        local jh = (self.JumpHeldDown == true)
        local jumpEdge = jh and not jumpWasHeld
        jumpWasHeld = jh

        local params = getParams(self, char)
        local pos = hrp.Position

        -- ---------- no enganchado: buscar pared hacia donde empujas
        if not attached then
            local bm = getBase(self)
            if not bm then return end
            local pv = bm.PlaneVelocity
            local intent = Vector3.new(pv.X, 0, pv.Y)
            if intent.Magnitude < CFG.MinIntent then return end
            local dir = intent.Unit
            local res = Workspace:Raycast(pos, dir * CFG.AttachDist, params)
            if not res then return end
            if math.abs(res.Normal.Y) > CFG.MaxWallY then return end
            if res.Instance and res.Instance.CanCollide == false then return end
            if dir:Dot(-res.Normal) < CFG.MinDot then return end
            attach(self, hrp, res)
            return
        end

        -- ---------- enganchado
        -- diagnostico del giro: lo que dejo el juego vs lo que escribimos el frame anterior
        if lastWritten and os.clock() - lastDiag >= 1 then
            lastDiag = os.clock()
            log("· giro: escrito up=" .. v3(lastWritten.UpVector) .. " | ahora up=" .. v3(hrp.CFrame.UpVector))
        end
        if jumpEdge then
            detach("salto", hrp, normal * CFG.JumpOff + Vector3.new(0, CFG.JumpOff * 0.6, 0))
            return
        end

        -- 1) seguir la pared (esquinas/curvas) y detectar el borde de arriba
        local into = -normal
        local res = Workspace:Raycast(pos, into * (CFG.AttachDist + 1), params)
        if res and okNormal(res.Normal) then
            normal = res.Normal
            lastNormal = normal
            dist = (res.Position - pos).Magnitude
            lostSince = nil
            into = -normal
        else
            lostSince = lostSince or os.clock()
            if os.clock() - lostSince > CFG.LostGrace then
                detach("pared perdida (borde)", hrp, into * CFG.MantleOut + Vector3.new(0, CFG.MantleUp, 0))
                return
            end
        end

        -- v3 (experimental): esquinas. Si caminas hacia otra superficie, pasas a ella (pared->pared, pared->techo)
        if CFG.Corners and moving and os.clock() - lastCorner > 0.4 then
            local ahead = Workspace:Raycast(pos, lookDir * (CFG.Hover + 1), params)
            if ahead and okNormal(ahead.Normal) and not (ahead.Instance and ahead.Instance.CanCollide == false) then
                local dn2 = ahead.Normal:Dot(normal)
                if dn2 < 0.8 and dn2 > -0.5 then
                    normal = ahead.Normal
                    lastNormal = normal
                    dist = (ahead.Position - pos).Magnitude
                    into = -normal
                    lastCorner = os.clock()
                    log("ESQUINA: nueva normal=" .. v3(normal))
                end
            end
        end

        -- 2) direccion pedida (la que el juego calcula en BaseMover.PlaneVelocity)
        local bm = baseMover
        local pv = bm and bm.PlaneVelocity
        local d = pv and Vector3.new(pv.X, 0, pv.Y) or Vector3.new(0, 0, 0)
        local dn = (d.Magnitude > 3) and d.Unit or Vector3.new(0, 0, 0)

        local up = Vector3.new(0, 1, 0)
        local tu = up - normal * up:Dot(normal)
        if tu.Magnitude < 0.05 then tu = lookDir end
        tu = tu.Unit
        local rightDir = tu:Cross(normal)
        -- v2: input relativo a la camara (adelante/derecha de la camara -> arriba/derecha en la pared)
        local wallVel = Vector3.new(0, 0, 0)
        local cam = Workspace.CurrentCamera
        if cam and dn.Magnitude > 0 then
            local cf = cam.CFrame
            local cl = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local cr = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            if cl.Magnitude > 0.05 and cr.Magnitude > 0.05 then
                local fwd = dn:Dot(cl.Unit)
                local rgt = dn:Dot(cr.Unit)
                local sUp = cf.UpVector - normal * cf.UpVector:Dot(normal)
                sUp = (sUp.Magnitude > 0.05) and sUp.Unit or tu
                local sRight = cf.RightVector - normal * cf.RightVector:Dot(normal)
                sRight = sRight / math.max(sRight.Magnitude, 0.3)
                if math.abs(normal.Y) > 0.7 then
                    -- techo (solo con Corners): como caminar en el suelo, relativo a la camara
                    sUp = cl.Unit
                    sRight = cr.Unit
                end
                wallVel = sUp * fwd + sRight * rgt
            end
        end

        -- 3) bajar hasta el suelo: soltarse
        if wallVel:Dot(up) < -0.1 then
            local g = Workspace:Raycast(pos, Vector3.new(0, -(CFG.Hover + 0.6), 0), params)
            if g and g.Normal.Y > 0.7 then
                detach("suelo", hrp)
                return
            end
        end

        -- 4) apagar el movimiento del juego y mover con el nuestro
        if bm then bm.Enabled = false end
        local err = dist - CFG.Hover
        lv.VectorVelocity = wallVel * CFG.Speed + into * math.clamp(err * 8, -8, 8)

        -- 5) girar: arriba del personaje = normal de la pared, mirando hacia donde caminas
        if wallVel.Magnitude > 0.1 then lookDir = wallVel.Unit end
        moving = wallVel.Magnitude > 0.1
        local f = lookDir - normal * lookDir:Dot(normal)
        if f.Magnitude < 0.05 then f = tu end
        f = f.Unit
        local right = f:Cross(normal).Unit
        local target = CFrame.fromMatrix(pos, right, normal, -f)
        hrp.CFrame = hrp.CFrame:Lerp(target, CFG.RotAlpha)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        lastWritten = hrp.CFrame

        -- debug cada 1 s
        if os.clock() - lastDbg >= 1 then
            lastDbg = os.clock()
            local md = hum.MoveDirection
            log("· pared dist=" .. string.format("%.2f", dist) .. " n=" .. v3(normal) .. " intent=" .. v3(d) ..
                " moveDir=" .. v3(md) .. " hum=" .. hum:GetState().Name .. " mv=" .. tostring(self.State))
        end
    end

    -- ============================================================ hook de Movement.Update
    local function ensureHook()
        if hooked then return true end
        local ok, M = pcall(function()
            return require(ReplicatedStorage.Objects.Game.Character.Client.Movement)
        end)
        if not ok or type(M) ~= "table" or type(M.Update) ~= "function" then return false end
        Movement = M
        oldUpdate = M.Update
        myUpdate = function(self, ...)
            oldUpdate(self, ...)
            local ok2, err = pcall(step, self)
            if not ok2 then
                local msg = tostring(err)
                if not errSeen[msg] then
                    errSeen[msg] = true
                    log("ERROR en Spider (se apaga): " .. msg)
                end
                if setSpider then pcall(setSpider, false) end
                if spyderToggle and spyderToggle.SetValue then pcall(spyderToggle.SetValue, false) end
            end
        end
        M.Update = myUpdate
        hooked = true
        return true
    end

    setSpider = function(on)
        if on then
            if not ensureHook() then
                log("No se pudo enganchar Movement.Update (falta el modulo del juego)")
                return false
            end
            enabled = true
            log("Spyder ON")
        else
            enabled = false
            if attached then detach("apagado", lastHrp) end
            log("Spyder OFF")
        end
        return true
    end

    GENVS.YY_Spyder = {
        Destroy = function()
            enabled = false
            if attached then detach("cerrado", lastHrp) end
        end
    }

    spyderToggle = TabExtra:CreateFloatingToggle("Spyder Beta", "Spyder Beta", false, function(state)
        if not setSpider(state) and state and spyderToggle and spyderToggle.SetValue then
            spyderToggle.SetValue(false)
        end
    end)

    TabExtra:CreateSlider(
        "Spyder Velocidad / Speed",
        10, 80, CFG.Speed,
        function(value)
            CFG.Speed = math.clamp(tonumber(value) or 28, 10, 80)
            Config.SpyderSpeed = CFG.Speed
            SaveSettings()
        end
    )

    TabExtra:CreateSlider(
        "Spyder Distancia a la pared / Hover",
        1.5, 5, CFG.Hover,
        function(value)
            CFG.Hover = math.clamp(tonumber(value) or 2.75, 1.5, 5)
            Config.SpyderHover = CFG.Hover
            SaveSettings()
        end
    )

    TabExtra:CreateSlider(
        "Spyder Suavidad del giro / Turn",
        0.1, 1, CFG.RotAlpha,
        function(value)
            CFG.RotAlpha = math.clamp(tonumber(value) or 0.35, 0.1, 1)
            Config.SpyderRotAlpha = CFG.RotAlpha
            SaveSettings()
        end
    )

    TabExtra:CreateFloatingToggle("Spyder Esquinas/Techo (exp)", "Spyder Corners/Ceiling (exp)", false, function(state)
        CFG.Corners = state
        log(state and "Esquinas/Techo ON (experimental)" or "Esquinas/Techo OFF")
    end)
end

