function OpenAvatarCatalog()
    local mainFrame = TabAvatar.Page:FindFirstAncestor("Main") or TabAvatar.Page.Parent
    if not AC.Built then
        build(mainFrame)
    end
    -- Tamaño segun la pantalla (no segun el hub: si el hub era mas chico o estaba animando, la ventana
    -- quedaba mas alta que el hub y se salia por arriba, y como se arrastra desde arriba no se podia mover)
    local screen = W.ScreenGui.AbsoluteSize
    if screen.X <= 0 or screen.Y <= 0 then
        screen = Vector2.new(800, 450)
    end
    local width = math.clamp(screen.X * 0.86, math.min(420, screen.X - 16), 820)
    local height = math.clamp(screen.Y * 0.84, math.min(260, screen.Y - 16), 520)
    W.Overlay.Size = UDim2.fromOffset(width, height)
    if not W.Placed then
        W.Overlay.Position = UDim2.fromOffset((screen.X - width) / 2, (screen.Y - height) / 2)
        W.Placed = true
    end
    W.ClampWindow()
    W.Overlay.Visible = true
    W.PanelScale.Scale = 0.94
    KeyTweenService:Create(W.PanelScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    local desc = currentDescription()
    AC.Original = desc and desc:Clone() or AC.Original
    refreshChips()
    refreshPreview()
    if AC.Mode == "worn" then
        renderWorn()
    elseif #AC.Tiles == 0 then
        search()
    else
        refreshTiles()
    end
end

-- La libreria repinta el tema solo dentro de "Main"; la ventana flotante se repinta sola con los mismos roles.
function RepaintAvatarCatalog()
    if not W.Overlay then return end
    local palette = pal()
    for _, obj in ipairs(W.Overlay:GetDescendants()) do
        local role = obj:GetAttribute("ThemeRole")
        if role and palette[role] then
            if obj:IsA("UIStroke") then
                obj.Color = palette[role]
            elseif obj:IsA("GuiObject") then
                obj.BackgroundColor3 = palette[role]
            end
        end
        local textRole = obj:GetAttribute("ThemeTextRole")
        if textRole and palette[textRole] and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
            obj.TextColor3 = palette[textRole]
        end
    end
    refreshChips()
    refreshTiles()
end

