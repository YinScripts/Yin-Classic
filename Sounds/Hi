local function currentCategory()
    for _, cat in ipairs(CATEGORIES[AC.Mode] or {}) do
        if cat[1] == AC.Category[AC.Mode] then
            return cat
        end
    end
    return nil
end

local function addPage(page)
    local desc = currentDescription()
    for _, item in ipairs(page or {}) do
        local isBundle = item.ItemType == "Bundle"
        local cat = currentCategory()
        local wantBundles = cat and cat[5] ~= nil
        if (isBundle and wantBundles) or (not isBundle and not wantBundles) then
            local tile = makeTile(item, #AC.Tiles + 1, isBundle)
            tile.Refresh(desc)
        end
    end
end

local function enumList(enumType, names)
    local list = {}
    for _, name in ipairs(names or {}) do
        local ok, enumItem = pcall(function() return enumType[name] end)
        if ok and enumItem then
            list[#list + 1] = enumItem
        end
    end
    return list
end

local function resultsText()
    return #AC.Tiles .. " resultados · tocá para ponerte o quitarte", #AC.Tiles .. " results · tap to wear or remove"
end

local function search()
    if AC.Mode == "worn" then return end
    AC.Token += 1
    local token = AC.Token
    clearTiles()
    AC.Pages = nil
    W.More.Visible = false
    W.Empty.Visible = false
    setStatus("Buscando en el catálogo...", "Searching the catalog...", Color3.fromRGB(195, 215, 255))
    local cat = currentCategory()
    AC.BundleParts = cat and cat[6] or nil -- partes que aplica cada paquete en esta categoria
    task.spawn(function()
        local ok, pages = pcall(function()
            local params = CatalogSearchParams.new()
            params.SearchKeyword = W.Search.Text or ""
            if cat and cat[5] then
                params.BundleTypes = enumList(Enum.BundleType, cat[5])
            else
                params.AssetTypes = enumList(Enum.AvatarAssetType, cat and cat[4] or {})
            end
            pcall(function() params.Limit = 30 end)
            local hasAsync = pcall(function() return AvatarEditorService.SearchCatalogAsync end)
            if hasAsync then
                return AvatarEditorService:SearchCatalogAsync(params)
            end
            return AvatarEditorService:SearchCatalog(params)
        end)
        if token ~= AC.Token then return end
        if not ok or not pages then
            setStatus("El catálogo no respondió. Probá de nuevo.", "The catalog did not respond. Try again.", Color3.fromRGB(255, 135, 135))
            warn("[Catálogo] SearchCatalogAsync:", pages)
            return
        end
        AC.Pages = pages
        local okPage, page = pcall(function() return pages:GetCurrentPage() end)
        if not okPage then
            setStatus("No se pudo leer el catálogo.", "Could not read the catalog.", Color3.fromRGB(255, 135, 135))
            return
        end
        addPage(page)
        W.More.Visible = not pages.IsFinished
        W.Empty.Visible = #AC.Tiles == 0
        if #AC.Tiles == 0 then
            setStatus("Sin resultados.", "No results.", Color3.fromRGB(255, 190, 120))
        else
            setStatus(resultsText())
        end
    end)
end

local function loadMore()
    local pages = AC.Pages
    if not pages or pages.IsFinished then return end
    local token = AC.Token
    W.More.Visible = false
    setStatus("Cargando más...", "Loading more...", Color3.fromRGB(195, 215, 255))
    task.spawn(function()
        local ok = pcall(function() pages:AdvanceToNextPageAsync() end)
        if token ~= AC.Token then return end
        if ok then
            local okPage, page = pcall(function() return pages:GetCurrentPage() end)
            if okPage then addPage(page) end
        end
        W.More.Visible = not pages.IsFinished
        setStatus(resultsText())
    end)
end

-- pestaña "Puesto": todo lo que tiene el avatar ahora, tocás y se quita
renderWorn = function()
    clearTiles()
    W.More.Visible = false
    local desc = currentDescription()
    if not desc then
        W.Empty.Visible = true
        setStatus("No se encontró tu rig visual (entrá a una partida).", "Your visual rig was not found (join a match).", Color3.fromRGB(255, 135, 135))
        return
    end
    local order = 0
    for assetType, map in pairs(ASSET_PROPS) do
        local ids = map[2] and idList(desc[map[1]]) or ((tonumber(desc[map[1]]) or 0) > 0 and { tostring(desc[map[1]]) } or {})
        for _, id in ipairs(ids) do
            order += 1
            local names = TYPE_NAMES[assetType] or { assetType, assetType }
            local tile = makeTile({ Id = id, Name = scriptText(names[1], names[2]), AssetType = assetType, Price = -1 }, order, false)
            tile.Refresh(desc)
        end
    end
    for _, entry in ipairs(layeredList(desc)) do
        local assetType = nil
        for typeName, accName in pairs(LAYERED) do
            local okEnum, enumItem = pcall(function() return Enum.AccessoryType[accName] end)
            if okEnum and enumItem == entry.AccessoryType then
                assetType = typeName
            end
        end
        if assetType then
            order += 1
            local names = TYPE_NAMES[assetType] or { assetType, assetType }
            local tile = makeTile({ Id = entry.AssetId, Name = scriptText(names[1], names[2]), AssetType = assetType, Price = -1 }, order, false)
            tile.Refresh(desc)
        end
    end
    W.Empty.Visible = order == 0
    setStatus(order .. " cosas puestas · tocá una para quitarla", order .. " items worn · tap one to remove it", Color3.fromRGB(180, 180, 190))
end

local function refreshChips()
