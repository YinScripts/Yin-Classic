-- ---------- logica del selector ----------
local function pickerColor()
    return Color3.fromHSV(Pk.H, Pk.S, Pk.V)
end

local function refreshChips()
    local row = Pk.Row
    if not row then
        return
    end
    local multi = #row.Item.Parts > 1
    chipRow.Visible = multi
    for part, chip in pairs(Pk.Chips) do
        local used = table.find(row.Item.Parts, part) ~= nil
        chip.Button.Visible = multi and used
        if used then
            chip.Dot.BackgroundColor3 = shownColor(row.Item, part)
            local active = part == Pk.Part
            chip.Stroke.Transparency = active and 0 or 1
            chip.Button.BackgroundTransparency = active and 0 or 0.4
        end
    end
end

local function refreshPicker()
    local selected = pickerColor()
    pickerArea.BackgroundColor3 = Color3.fromHSV(Pk.H, 1, 1)
    afterSwatch.BackgroundColor3 = selected
    svHandle.Position = UDim2.new(Pk.S, 0, 1 - Pk.V, 0)
    hueHandle.Position = UDim2.new(0.5, 0, Pk.H, 0)
    if not hexField:IsFocused() then hexField.Text = "#" .. toHex(selected) end
    if not redField:IsFocused() then redField.Text = tostring(math.floor(selected.R * 255 + 0.5)) end
    if not greenField:IsFocused() then greenField.Text = tostring(math.floor(selected.G * 255 + 0.5)) end
    if not blueField:IsFocused() then blueField.Text = tostring(math.floor(selected.B * 255 + 0.5)) end
end

-- aplica en vivo (sin guardar) el color de la parte que se esta editando
local function livePaint(color, force)
    local row = Pk.Row
    if not row then
        return
    end
    local now = os.clock()
    if not force and now - HC.LastLive < 1 / 30 then
        return
    end
    HC.LastLive = now
    local entry = entryOf(row.Item, Pk.Part)
    HC.Saved[entry.Key] = color
    applyEntry(entry)
    rowRefresh(row)
    refreshChips()
end

setPickerColor = function(color, paint)
    local h, s, v = color:ToHSV()
    if s > 0.001 then
        Pk.H = h -- en grises se conserva el tono para que la barra no salte
    end
    Pk.S, Pk.V = s, v
    refreshPicker()
    if paint then
        livePaint(color, true)
    end
end

local function selectPart(part)
    Pk.Part = part
    local key = Pk.Row.Item.Key .. ":" .. part
    local current = HC.Saved[key] or defaultColor(Pk.Row.Item, part)
    beforeSwatch.BackgroundColor3 = Pk.Before[key] or defaultColor(Pk.Row.Item, part)
    setPickerColor(current, false)
    refreshChips()
end

for part, chip in pairs(Pk.Chips) do
    chip.Button.Activated:Connect(function()
        if Pk.Row then
            selectPart(part)
        end
    end)
end

local function closePicker(keep)
    local row = Pk.Row
    if not row then
        return
    end
    if not keep then
        -- Cancelar: vuelve todo lo que se toco a como estaba al abrir
        for _, part in ipairs(row.Item.Parts) do
            local key = row.Item.Key .. ":" .. part
            HC.Saved[key] = Pk.Before[key]
            applyEntry(entryOf(row.Item, part))
        end
    else
        saveFile()
    end
    rowRefresh(row)
    statusRefresh()
    Pk.Row, Pk.Drag = nil, nil
    overlay.Visible = false
end

openPicker = function(row)
    Pk.Row = row
    Pk.Before = {}
    for _, part in ipairs(row.Item.Parts) do
        local key = row.Item.Key .. ":" .. part
        Pk.Before[key] = HC.Saved[key]
    end
    setBilingual(pickerTitle, "Color · " .. row.Item.Es, "Color · " .. row.Item.En)
    overlay.Visible = true
    selectPart(row.Item.Parts[1])
end

local function updateSV(position)
    local size = pickerArea.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    Pk.S = math.clamp((position.X - pickerArea.AbsolutePosition.X) / size.X, 0, 1)
    Pk.V = math.clamp(1 - (position.Y - pickerArea.AbsolutePosition.Y) / size.Y, 0, 1)
    refreshPicker()
    livePaint(pickerColor(), false)
end

local function updateHue(position)
    local size = hueBar.AbsoluteSize
    if size.Y <= 0 then return end
    Pk.H = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / size.Y, 0, 0.999)
    refreshPicker()
    livePaint(pickerColor(), false)
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
pickerArea.InputBegan:Connect(function(input)
    if isPress(input) then
        Pk.Drag = "SV"
        updateSV(input.Position)
    end
end)
hueBar.InputBegan:Connect(function(input)
    if isPress(input) then
        Pk.Drag = "H"
        updateHue(input.Position)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not Pk.Drag then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if Pk.Drag == "SV" then updateSV(input.Position) else updateHue(input.Position) end
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if Pk.Drag and isPress(input) then
        Pk.Drag = nil
        livePaint(pickerColor(), true) -- el ultimo punto siempre se aplica
    end
end)

