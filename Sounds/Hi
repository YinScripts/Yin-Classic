-- ===== CARGAR JUGADOR (Carry) =====
-- Verificado en el código del juego: ReplicatedStorage.Objects.Game.Character.Shared.StateInfo tiene los estados
-- CarryIdle / CarryMove / CarryCrouchIdle / CarryCrouchMove / CarrySlide / CarrySlideAir / CarryAir
-- (Requirements.Carrying = true) con CanUseTools = false y Movement.CanJump = false. ToolProfile, Usables y
-- Movement leen esas tablas en vivo (GetState), así que cambiarlas en el módulo real alcanza.
-- Necesita require → no se usa en Solara (allí require da una copia y el cambio no llegaría al juego).
-- Funcion global (no local) por el limite de 200 registros del chunk principal.
function setupCarrySection()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local isSolara = false
    pcall(function()
        if identifyexecutor then
            isSolara = string.find(string.lower(tostring(identifyexecutor())), "solara", 1, true) ~= nil
        end
    end)
    local C = { Tools = false, Jump = false, Mod = nil }
    -- originales guardados en getgenv: si el script se re-ejecuta con algo encendido, no se pierden
    env.YYCarryOrig = env.YYCarryOrig or {}
    local Orig = env.YYCarryOrig

    local function stateModule()
        if C.Mod then return C.Mod end
        if isSolara then return nil end
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Objects.Game.Character.Shared.StateInfo)
        end)
        if ok and type(mod) == "table" and type(mod.GetState) == "function" then C.Mod = mod end
        return C.Mod
    end

    local function carryStates(mod)
        local list = {}
        if type(mod.States) == "table" then
            for _, st in ipairs(mod.States) do
                if type(st) == "table" and type(st.State) == "string" and type(st.Requirements) == "table" and st.Requirements.Carrying == true then
                    table.insert(list, st)
                end
            end
        end
        if #list == 0 then
            for _, name in ipairs({ "CarryIdle", "CarryMove", "CarryCrouchIdle", "CarryCrouchMove", "CarrySlide", "CarrySlideAir", "CarryAir" }) do
                local st = mod:GetState(name)
                if type(st) == "table" then table.insert(list, st) end
            end
        end
        return list
    end

    local function apply()
        local mod = stateModule()
        if not mod then return false end
        for _, st in ipairs(carryStates(mod)) do
            local o = Orig[st.State]
            if not o then
                o = { CanUseTools = st.CanUseTools, CanUseUsables = st.CanUseUsables }
                if type(st.Movement) == "table" then
                    o.CanJump = st.Movement.CanJump
                    o.JumpButtonVisible = st.Movement.JumpButtonVisible
                end
                Orig[st.State] = o
            end
            if C.Tools then
                st.CanUseTools = true
                if o.CanUseUsables ~= nil then st.CanUseUsables = true end
            else
                st.CanUseTools = o.CanUseTools
                st.CanUseUsables = o.CanUseUsables
            end
            if type(st.Movement) == "table" then
                if C.Jump then
                    st.Movement.CanJump = true
                    st.Movement.JumpButtonVisible = true
                else
                    st.Movement.CanJump = o.CanJump
                    st.Movement.JumpButtonVisible = o.JumpButtonVisible
                end
            end
        end
        return true
    end

    TabExtra:CreateLabel("CARGAR JUGADOR", "CARRYING", 14)
    TabExtra:CreateDivider()
    if isSolara then
        TabExtra:CreateLabel("No disponible en Solara", "Not available on Solara", 11)
    end
    local toolsToggle, jumpToggle
    toolsToggle = TabExtra:CreateToggle("Usar objetos mientras cargas", "Use items while carrying", false, function(enabled)
        C.Tools = enabled
        if not apply() and enabled then
            warn("[Carry] No se pudo usar StateInfo (Solara o módulo no encontrado)")
            C.Tools = false
            if toolsToggle and toolsToggle.SetValue then toolsToggle.SetValue(false) end
        end
    end)
    jumpToggle = TabExtra:CreateToggle("Saltar mientras cargas", "Jump while carrying", false, function(enabled)
        C.Jump = enabled
        if not apply() and enabled then
            warn("[Carry] No se pudo usar StateInfo (Solara o módulo no encontrado)")
            C.Jump = false
            if jumpToggle and jumpToggle.SetValue then jumpToggle.SetValue(false) end
        end
    end)
    TabExtra:CreateDivider()
end
