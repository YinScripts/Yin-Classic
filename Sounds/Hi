local function layeredList(desc)
    local ok, list = pcall(function() return desc:GetAccessories(false) end)
    return (ok and type(list) == "table") and list or {}
end

local function idList(value)
    local list = {}
    for id in tostring(value or ""):gmatch("%d+") do
        list[#list + 1] = id
    end
    return list
end

local function isEquipped(desc, assetType, id)
    if desc and LAYERED[assetType] then
        for _, entry in ipairs(layeredList(desc)) do
            if tostring(entry.AssetId) == tostring(id) then
                return true
            end
        end
        return false
    end
    local map = ASSET_PROPS[assetType]
    if not (desc and map) then
        return false
    end
    local value = desc[map[1]]
    if map[2] then
        return table.find(idList(value), tostring(id)) ~= nil
    end
    return tonumber(value) == tonumber(id)
end

