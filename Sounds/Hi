-- El cuerpo se centra por el torso (no por la caja de todo el modelo: si el modelo trae partes extra
-- lejos del cuerpo, la caja crece y el personaje queda chiquito en una esquina).
local function corePart(model)
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso") or model.PrimaryPart
end

local function placePreview()
    local model = W.PreviewModel
    if not model then return end
    pcall(function()
        -- el torso queda en (0,0,0) y gira sobre si mismo
        model:PivotTo(CFrame.Angles(0, math.rad(AC.Angle), 0) * (W.CoreOffset or CFrame.new()))
    end)
end

local function framePreview()
    -- encuadre fijo de un cuerpo (R6/R15: cabeza a pies ~5 studs + margen para sombreros), centrado en el torso
    local center = Vector3.new(0, -0.35, 0)
    local height = 6.6
    local distance = (height * 0.5) / math.tan(math.rad(W.Camera.FieldOfView * 0.5))
    -- los personajes de Roblox miran hacia -Z: la camara va de ese lado para verlos de frente
    W.Camera.CFrame = CFrame.new(center + Vector3.new(0, 0.4, -distance), center)
end

-- Vista previa: modelo armado desde la descripcion actual (se rehace solo cuando cambia algo)
local function refreshPreview()
    if not W.Viewport then return end
    AC.PreviewToken += 1
    local token = AC.PreviewToken
    W.Loading.Visible = true
    task.spawn(function()
        local desc = currentDescription()
        -- 1) copia del rig visual del juego: muestra exactamente lo que tenes puesto (pelo, accesorios, cosmeticos).
        -- Roblox no copia los objetos con Archivable = false (por eso faltaban los accesorios): se activa un
        -- momento en todo el rig, se copia y se deja como estaba.
        local model = nil
        local rig = GetAvatarVisualHumanoid()
        if rig then
            local changed = {}
            pcall(function()
                if not rig.Archivable then
                    changed[#changed + 1] = rig
                    rig.Archivable = true
                end
                for _, d in ipairs(rig:GetDescendants()) do
                    if not d.Archivable then
                        changed[#changed + 1] = d
                        d.Archivable = true
                    end
                end
            end)
            local okClone, cloned = pcall(function() return rig:Clone() end)
            for _, inst in ipairs(changed) do
                pcall(function() inst.Archivable = false end)
            end
            if okClone and typeof(cloned) == "Instance" then
                model = cloned
            end
        end
        -- 2) respaldo: modelo armado desde la descripcion
        if not model and desc then
            local ok, result = pcall(function()
                -- en una Instance, leer un metodo que no existe tira error (no devuelve nil)
                local hasAsync = pcall(function() return Players.CreateHumanoidModelFromDescriptionAsync end)
                if hasAsync then
                    return Players:CreateHumanoidModelFromDescriptionAsync(desc, currentRigType())
                end
                return Players:CreateHumanoidModelFromDescription(desc, currentRigType())
            end)
            if ok and typeof(result) == "Instance" then
                model = result
            elseif not ok then
                warn("[Catálogo] Vista previa:", result)
            end
        end
        if token ~= AC.PreviewToken then
            if model then pcall(function() model:Destroy() end) end
            return
        end
        if W.PreviewModel then
            pcall(function() W.PreviewModel:Destroy() end)
            W.PreviewModel = nil
        end
        if not model then
            W.Loading.Text = scriptText("Sin vista previa", "No preview")
            return
        end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
                pcall(function() d:Destroy() end)
            elseif d:IsA("BasePart") then
                d.Anchored = true
            end
        end
        model.Parent = W.World
        W.PreviewModel = model
        local core = corePart(model)
        W.CoreOffset = CFrame.new()
        if core then
            pcall(function()
                -- pivote del modelo visto desde el torso, sin la inclinacion que pudiera tener el torso
                local upright = CFrame.new(core.Position) * CFrame.Angles(0, select(2, core.CFrame:ToOrientation()), 0)
                W.CoreOffset = upright:Inverse() * model:GetPivot()
            end)
        end
        placePreview()
        -- fuera de la vista previa todo lo que no sea del cuerpo (partes a mas de 10 studs del torso)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Magnitude > 14 then
                pcall(function() d:Destroy() end)
            end
        end
        framePreview()
        W.Loading.Visible = false
    end)
end

