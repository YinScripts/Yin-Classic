-- ===== MODO ESPACIO (gravedad cero, el personaje flota y gira como una roca) =====
-- Verificado en el código del juego: el estado "Grappling" de StateInfo (prioridad 999999, Requirements.Grappling = true)
-- pone PlatformStand = true, HumanoidRootPart.Massless = true, prende la fuerza "GrappleForce"
-- (VectorForce hacia arriba = 8.684 × Gravity, cancela el peso) y usa RootPartOrientation "None" (nada te endereza).
-- Es lo que se vio al quedar "trabado" enganchado antes de la pantalla de carga (MapLoading pausa la actualización).
-- Esta opción mantiene DataRegistry "Grappling" = true en TU personaje (CharacterService:GetLocalCharacter) y el juego
-- aplica solo todo lo anterior. Ojo: ese dato se le manda al servidor (DataRegistry.Set → UpdateCharacterDataRegistry).
-- Como "Grappling" le gana a Downed / Ragdolling / Carried, mientras estás caído, en ragdoll o cargado se pausa sola.
-- Necesita require → no se usa en Solara (allí require da una copia y puede matar al personaje).
-- Funcion global (no local) por el limite de 200 registros del chunk principal.
function setupSpaceSection()
    local isSolara = false
    pcall(function()
        if identifyexecutor then
            isSolara = string.find(string.lower(tostring(identifyexecutor())), "solara", 1, true) ~= nil
        end
    end)
    local S = { On = false, Conn = nil, CS = nil, Ours = false }

    local function charService()
        if S.CS then return S.CS end
        if isSolara then return nil end
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Services.Asset.CharacterService)
        end)
        if ok and type(mod) == "table" and type(mod.GetLocalCharacter) == "function" then S.CS = mod end
        return S.CS
    end

    local function localRegistry()
        local cs = charService()
        if not cs then return nil end
        local ok, c = pcall(function() return cs:GetLocalCharacter() end)
        if ok and type(c) == "table" and type(c.DataRegistry) == "table" then return c.DataRegistry end
        return nil
    end

    local function paused(reg)
        return reg:Get("Downed") == true or reg:Get("Ragdolling") == true or (reg:Get("Carried") or 0) ~= 0
    end

    local function step()
        local reg = localRegistry()
        if not reg then return end
        if paused(reg) then
            if S.Ours and reg:Get("Grappling") == true then reg:Set("Grappling", false) end
            S.Ours = false
            return
        end
        if reg:Get("Grappling") ~= true then reg:Set("Grappling", true) end
        S.Ours = true
    end

    local function stop()
        if S.Conn then S.Conn:Disconnect() S.Conn = nil end
        if S.Ours then
            local reg = localRegistry()
            if reg then pcall(function() reg:Set("Grappling", false) end) end
        end
        S.Ours = false
    end

    TabExtra:CreateLabel("MODO ESPACIO", "SPACE MODE", 14)
    TabExtra:CreateDivider()
    if isSolara then
        TabExtra:CreateLabel("No disponible en Solara", "Not available on Solara", 11)
    end
    local spaceToggle
    spaceToggle = TabExtra:CreateToggle("Gravedad cero (roca en el espacio)", "Zero gravity (space rock)", false, function(enabled)
        S.On = enabled
        stop()
        if not enabled then return end
        if not charService() then
            warn("[Espacio] No se pudo usar CharacterService (Solara o módulo no encontrado)")
            S.On = false
            if spaceToggle and spaceToggle.SetValue then spaceToggle.SetValue(false) end
            return
        end
        S.Conn = RunService.Heartbeat:Connect(function()
            local ok, err = pcall(step)
            if not ok then warn("[Espacio] " .. tostring(err)) end
        end)
    end)
    TabExtra:CreateDivider()
end
