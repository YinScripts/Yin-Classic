        for _, dx in ipairs({10, -8, 6, -4, 0}) do
            K.tween(panel, 0.05, {Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset)}, Enum.EasingStyle.Sine)
            task.wait(0.05)
        end
        panel.Position = base
    end

    local function dismiss()
        pcall(function() ringSpin:Cancel() end)
        pcall(function() spinnerTween:Cancel() end)
        K.tween(shade, 0.22, {BackgroundTransparency = 1})
        local out = K.tween(panelScale, 0.22, {Scale = 0.9}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        out.Completed:Wait()
        if gui.Parent then
            gui:Destroy()
        end
    end

    function tryAccess(value, fromCache)
        if busy or closed then
            return
        end

        busy = true
        input.Text = normalizeAccessKey(value)
        checkButton.Text = keyText("checking")
        setSpinner(true)
        setKeyStatus(fromCache and "revalidating" or "contacting", K.WORK)

        local valid, message = validateAccessKey(input.Text)
        setSpinner(false)
        if valid then
            saveCachedKey(input.Text)
            authorized = true
            getgenv().EvadeBetaKeyValidated = true
            setKeyStatus("accepted", K.OK)
            checkButton.Text = keyText("access_granted")
            K.tween(checkButton, 0.25, {BackgroundColor3 = K.OK})
            markSteps(3)
            task.wait(0.45)
            dismiss()
        else
            local statusKind =
                message == "INVALID FORMAT" and "invalid_format"
                or message == "SERVER UNAVAILABLE" and "server_unavailable"
                or message == "INVALID RESPONSE" and "invalid_response"
                or message == "INVALID OR EXPIRED KEY" and (fromCache and "invalid_expired_removed" or "invalid_expired")
                or "secure"

            if fromCache and message == "INVALID OR EXPIRED KEY" then
                clearCachedKey()
                input.Text = ""
            end

            setKeyStatus(statusKind, K.ERR)
            checkButton.Text = keyText("check")
            fieldStroke.Color = K.ERR
            fieldStroke.Transparency = 0.1
            shake()
            task.delay(1.2, function()
                if fieldStroke.Parent then
                    K.tween(fieldStroke, 0.3, {Color = Color3.new(1, 1, 1), Transparency = 0.78})
                end
            end)
        end
        busy = false
    end

    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            tryAccess(input.Text, false)
        end
    end)

    linkButton.Activated:Connect(function()
        if setclipboard then
            pcall(setclipboard, KEY_PORTAL_URL)
            setKeyStatus("link_copied", K.OK)
        else
            setKeyStatus("portal", K.WORK)
        end
        if normalizeAccessKey(input.Text) == "" then markSteps(2) end
    end)

    close.Activated:Connect(function()
        closed = true
        task.spawn(dismiss)
    end)

    checkButton.Activated:Connect(function()
        tryAccess(input.Text, false)
    end)

    -- Entrada animada
    K.tween(shade, 0.3, {BackgroundTransparency = 0.25})
    K.tween(panelScale, 0.45, {Scale = 1}, Enum.EasingStyle.Back)
    refreshFormat()

    local cachedKey = loadCachedKey()
    if cachedKey then
        input.Text = cachedKey
        task.spawn(function()
            task.wait()
            tryAccess(cachedKey, true)
        end)
    elseif not hasKeyCacheSupport() then
        setKeyStatus("no_file_support", K.WORK)
    end
    while not authorized and not closed do
        task.wait()
    end

    return authorized
end

