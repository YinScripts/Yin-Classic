-- ---------- busqueda en el HUD (rutas leidas del codigo del juego) ----------
local function findPath(root, ...)
    local cur = root
    for _, name in ipairs({ ... }) do
        cur = cur and cur:FindFirstChild(name)
    end
    return cur
end

-- Contenedores de botones: MobileButtons.ButtonInfo:GetButtonChildren
local function findButton(hud, name)
    local mobile = hud and hud:FindFirstChild("Mobile")
    if not mobile then
        return nil
    end
    for _, parent in ipairs({
        findPath(mobile, "Center", "Interact", "Interact"),
        findPath(mobile, "Left", "Mobile"),
        findPath(mobile, "Right", "Mobile"),
    }) do
        local b = parent and parent:FindFirstChild(name)
        if b then
            return b
        end
    end
    return nil
end

local function hasImage(inst)
    return (inst:IsA("ImageButton") or inst:IsA("ImageLabel")) and tostring(inst.Image or "") ~= ""
end

-- Devuelve { {inst, prop}, ... } de una entrada (item + parte)
local function collectTargets(entry)
    local item, part = entry.Item, entry.Part
    local out, extras = {}, {}
    local function add(inst, prop)
        out[#out + 1] = { inst, prop }
    end
    -- extra: propiedad que se cambia mientras la parte esta personalizada (y se restaura en Original)
    local function addExtra(inst, prop, value)
        extras[#extras + 1] = { inst, prop, value }
    end

    if item.Kind == "jump" then
        if HC.Jump and HC.Jump.Parent then
            add(HC.Jump, "ImageColor3")
        end
        return out, extras
    end

    if item.Kind == "topbar" then
        -- botones creados por el script en la barra superior (marcados con el atributo YYTopbar)
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local bar = pg and pg:FindFirstChild("TopbarStandard")
        if bar then
            for _, button in ipairs(bar:GetDescendants()) do
                if button.Name == item.TopName and button:GetAttribute("YYTopbar") then
                    local iconButton = button:FindFirstChild("IconButton")
                    local iconImage = iconButton and iconButton:FindFirstChild("IconImage")
                    local ring = iconButton and iconButton:FindFirstChild("YYRing")
                    local ringStroke = ring and ring:FindFirstChildOfClass("UIStroke")
                    if part == "icon" and iconImage then
                        add(iconImage, "ImageColor3")
                    elseif part == "bg" and iconButton then
                        add(iconButton, "BackgroundColor3")
                    elseif part == "border" and ringStroke then
                        add(ringStroke, "Color")
                        addExtra(ringStroke, "Transparency", 0.05)
                    end
                end
            end
        end
        return out, extras
    end

    local hud = HC.Hud
    if not hud then
        return out, extras
    end

    if item.Kind == "wheel" then
        -- PopupService.Types.Emote/Usables: en celular los anillos se ocultan (ImageTransparency = 1)
        -- y lo que se ve es el fondo de EmoteN.Button / ItemN.Button. En PC se ven los anillos.
        local popup = findPath(hud, "Interactors", "Popups", item.Popup)
        if popup then
            for _, wheelName in ipairs({ "Wheel", "Wheel2" }) do
                local wheel = popup:FindFirstChild(wheelName)
                if wheel then
                    for _, child in ipairs(wheel:GetChildren()) do
                        local slotButton = child:IsA("Frame") and child:FindFirstChild("Button")
                        if part == "bg" and slotButton and slotButton:IsA("GuiObject") then
                            add(slotButton, "BackgroundColor3")
                        elseif part == "border" and child:IsA("ImageLabel") and child.Name:match("^Ring%d+$") then
                            -- anillos (solo se ven en PC); los UIStroke de los casilleros son el contorno de los textos
                            add(child, "ImageColor3")
                        end
                    end
                end
            end
        end
    elseif item.Kind == "health" then
        local health = findPath(hud, "Overlay", "CharacterStatus", "BottomLeft", "Health")
        if health then
            local icon = health:FindFirstChild("HealthIcon")
            local text = health:FindFirstChild("Health")
            local stroke = findPath(health, "BackgroundStroke", "UIStroke")
            if icon then add(icon, "ImageColor3") end
            if text then add(text, "TextColor3") end
            if stroke then add(stroke, "Color") end
        end
    elseif item.Kind == "speed" then
        -- Speedometer: numero "Speed" + icono "ImageLabel"; los dos tienen un UIGradient (el naranja) que
        -- multiplica el color, asi que se apaga mientras haya color elegido. "Background" es la sombra: no se toca.
        local speed = findPath(hud, "Overlay", "CharacterStatus", "BottomLeft", "Speedometer")
        if speed then
            local number = speed:FindFirstChild("Speed")
            local icon = speed:FindFirstChild("ImageLabel")
            if number and number:IsA("TextLabel") then
                add(number, "TextColor3")
                local g = number:FindFirstChildOfClass("UIGradient")
                if g then addExtra(g, "Enabled", false) end
            end
            if icon and icon:IsA("ImageLabel") then
                add(icon, "ImageColor3")
                local g = icon:FindFirstChildOfClass("UIGradient")
                if g then addExtra(g, "Enabled", false) end
            end
        end
    elseif item.Kind == "button" then
        for _, buttonName in ipairs(item.Buttons or { item.Button }) do
        local button = findButton(hud, buttonName)
        if button then
            local iconChildren = {}
            for _, child in ipairs(button:GetChildren()) do
                if child:IsA("ImageLabel") or child:IsA("TextLabel") then
                    iconChildren[#iconChildren + 1] = child
                end
            end
            if part == "icon" then
                for _, child in ipairs(iconChildren) do
                    add(child, child:IsA("ImageLabel") and "ImageColor3" or "TextColor3")
                end
                -- sin hijos de icono: el dibujo es la imagen del propio boton
                if #iconChildren == 0 and hasImage(button) then
                    add(button, "ImageColor3")
                end
            elseif part == "bg" then
                add(button, "BackgroundColor3")
            elseif part == "border" then
                -- borde exterior = UIStroke hijo directo (viene casi invisible: Transparency 0.8).
                -- El UIStroke del Frame interno es la sombra negra: no se toca.
                local outer = button:FindFirstChildOfClass("UIStroke")
                if outer then
                    add(outer, "Color")
                    addExtra(outer, "Transparency", 0.15)
                end
            end
        end
        end
    end
    return out, extras
end

-- Colores que el juego pone a proposito y que NO se pisan (avisos del juego)
local function isGameStateColor(entry, value)
    local kind, part = entry.Item.Kind, entry.Part
    if kind == "wheel" and part == "border" then
        return sameColor(value, WHITE)          -- hover / seleccion (anillo)
    elseif kind == "button" and part == "icon" then
        return sameColor(value, PRESS_GRAY)     -- boton presionado
    elseif kind == "button" and part == "bg" then
        return sameColor(value, PRESS_BG)       -- boton presionado
    elseif kind == "health" then
        return sameColor(value, GAME_LOW_HP)    -- poca vida
    end
    return false
end

-- ---------- bordes animados (UIGradient + tween nativo en bucle: sin loops de Lua por frame) ----------
HC.Anim = { Mode = "off", Speed = "normal", Locked = true } -- Locked: sin el pase "Yin Yang Colors" no se animan
HC.AnimFile = "YinYang_HudAnim.json"
HC.AnimGrads = setmetatable({}, { __mode = "k" }) -- [inst] = UIGradient puesto por el script
local ANIM_SPEEDS = { slow = 6, normal = 3, fast = 1.4 }
local function gradientOf(colors)
    local keys = {}
    for i, c in ipairs(colors) do
        keys[i] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), c)
    end
    return ColorSequence.new(keys)
end
local ANIM_MODES = {
    rainbow = gradientOf({ Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 210, 80), Color3.fromRGB(110, 255, 120),
        Color3.fromRGB(80, 200, 255), Color3.fromRGB(170, 110, 255), Color3.fromRGB(255, 90, 90) }),
    neon = gradientOf({ Color3.fromRGB(0, 255, 230), Color3.fromRGB(255, 0, 200), Color3.fromRGB(0, 255, 230) }),
    fire = gradientOf({ Color3.fromRGB(255, 40, 0), Color3.fromRGB(255, 150, 0), Color3.fromRGB(255, 235, 90), Color3.fromRGB(255, 40, 0) }),
    ice = gradientOf({ Color3.fromRGB(180, 240, 255), Color3.fromRGB(60, 140, 255), Color3.fromRGB(240, 250, 255), Color3.fromRGB(180, 240, 255) }),
}

local function isAnimEntry(entry)
    return not HC.Anim.Locked and HC.Anim.Mode ~= "off" and entry.Part == "border" and (entry.Item.Kind == "button" or entry.Item.Kind == "wheel" or entry.Item.Kind == "topbar")
end

-- Color que se busca poner: con borde animado el borde va en blanco (el UIGradient multiplica el color)
local function wantOf(entry)
    if isAnimEntry(entry) then
        return WHITE
    end
    return HC.Saved[entry.Key]
end

local function animSequence(entry)
    if HC.Anim.Mode == "theme" then
        -- "Mi color": el color elegido para ese borde (o el acento del hub) con un brillo que gira
        local c = HC.Saved[entry.Key] or GetAvatarPalette().Accent
        local h, sat = c:ToHSV()
        return gradientOf({ c, Color3.fromHSV(h, sat * 0.3, 1), c })
    end
    return ANIM_MODES[HC.Anim.Mode] or ANIM_MODES.rainbow
end

local function applyAnim(entry)
    local on = isAnimEntry(entry)
    for _, t in ipairs(entry.Targets) do
        local inst = t[1]
        local g = HC.AnimGrads[inst]
        if on and inst.Parent then
            if not g or g.Parent ~= inst then
                g = Instance.new("UIGradient")
                g.Name = "YY_AnimBorder"
                g.Rotation = 0
                g.Color = animSequence(entry)
                g.Parent = inst
                HC.AnimGrads[inst] = g
                KeyTweenService:Create(g, TweenInfo.new(ANIM_SPEEDS[HC.Anim.Speed] or 3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Rotation = 360 }):Play()
            else
                g.Color = animSequence(entry)
            end
        elseif g then
            HC.AnimGrads[inst] = nil
            pcall(function() g:Destroy() end)
        end
    end
end

-- Al cambiar la velocidad se borran y se vuelven a crear (el tween infinito no cambia de duracion)
local function resetAnimGradients()
    for inst, g in pairs(HC.AnimGrads) do
        HC.AnimGrads[inst] = nil
        pcall(function() g:Destroy() end)
    end
end

local function paintTarget(entry, t)
    local inst, prop = t[1], t[2]
    local want = wantOf(entry)
    if not want or not inst.Parent then
        return
    end
    local current = inst[prop]
    if sameColor(current, want) or isGameStateColor(entry, current) then
        return
    end
    t.Painting = true
    inst[prop] = want
    t.Painting = false
end

local function unbindEntry(entry)
    for _, c in ipairs(entry.Conns) do
        pcall(function() c:Disconnect() end)
    end
    entry.Conns = {}
    entry.Targets = {}
    entry.Extras = {}
end

local function applyExtras(entry)
    local custom = wantOf(entry) ~= nil
    for _, x in ipairs(entry.Extras or {}) do
        local inst, prop = x[1], x[2]
        local orig = HC.Orig[inst]
        if inst.Parent and orig and orig[prop] ~= nil then
            local want = orig[prop]
            if custom then
                want = x[3] -- puede ser false (UIGradient.Enabled): no usar "and/or"
            end
            if inst[prop] ~= want then
                pcall(function() inst[prop] = want end)
            end
        end
    end
end

local function bindEntry(entry)
    unbindEntry(entry)
    local targets, extras = collectTargets(entry)
    for _, x in ipairs(extras) do
        local orig = HC.Orig[x[1]]
        if not orig then
            orig = {}
            HC.Orig[x[1]] = orig
        end
        if orig[x[2]] == nil then
            orig[x[2]] = x[1][x[2]] -- valor original del juego (se conserva en re-escaneos)
        end
    end
    entry.Extras = extras
    applyExtras(entry)
    for _, pair in ipairs(targets) do
        local t = { pair[1], pair[2] }
        local orig = HC.Orig[t[1]]
        if not orig then
            orig = {}
            HC.Orig[t[1]] = orig
        end
        if orig[t[2]] == nil then
            orig[t[2]] = t[1][t[2]] -- color del juego antes de pintar (se conserva en re-escaneos)
        end
        entry.Targets[#entry.Targets + 1] = t
        entry.Conns[#entry.Conns + 1] = t[1]:GetPropertyChangedSignal(t[2]):Connect(function()
            if t.Painting then
                return
            end
            local value = t[1][t[2]]
            local want = wantOf(entry)
            if not (want and sameColor(value, want)) then
                HC.Orig[t[1]][t[2]] = value -- ultimo color que puso el juego (para restaurar)
            end
            paintTarget(entry, t)
        end)
        paintTarget(entry, t)
    end
    applyAnim(entry)
end

local function applyEntry(entry)
    applyExtras(entry)
    if wantOf(entry) then
        for _, t in ipairs(entry.Targets) do
            paintTarget(entry, t)
        end
    else
        for _, t in ipairs(entry.Targets) do
            local orig = HC.Orig[t[1]]
            local gameColor = orig and orig[t[2]]
            if t[1].Parent and gameColor then
                t.Painting = true
                pcall(function() t[1][t[2]] = gameColor end)
                t.Painting = false
            end
        end
    end
    applyAnim(entry)
end

local statusRefresh -- se define con la UI

local function bindKind(filter)
    for _, entry in ipairs(HC.Entries) do
        if filter(entry.Item.Kind) then
            bindEntry(entry)
        end
    end
    if statusRefresh then
        statusRefresh()
    end
end

local function isHudKind(kind) return kind ~= "jump" end
local function isJumpKind(kind) return kind == "jump" end

local function setHud(hud)
    for _, c in ipairs(HC.HudConns) do
        pcall(function() c:Disconnect() end)
    end
    HC.HudConns = {}
    HC.Hud = hud
    bindKind(isHudKind)
    if not hud then
        return
    end
    -- Algunas piezas (botones de celular, etc.) pueden aparecer un poco despues: un re-escaneo corto
    task.delay(2, function()
        if HC.Hud == hud and hud.Parent then
            bindKind(isHudKind)
        end
    end)
    HC.HudConns[#HC.HudConns + 1] = hud.AncestryChanged:Connect(function()
        if not hud:IsDescendantOf(game) and HC.Hud == hud then
            setHud(nil)
        end
    end)
end

local function tryGameGui(gui)
    if not gui or gui.Name ~= "Game" or not gui:IsA("ScreenGui") then
        return
    end
    task.spawn(function()
        local hud = gui:WaitForChild("HUD", 10)
        if hud and gui.Parent then
            setHud(hud)
        end
    end)
end

-- Boton de saltar de Roblox (PlayerModule.ControlModule.TouchJump): se puede recrear al rotar/redimensionar
local function setJump(button)
    HC.Jump = button
    bindKind(isJumpKind)
end

local function watchTouchFrame(frame)
    local function check(child)
        if child.Name == "JumpButton" and child:IsA("ImageButton") then
            setJump(child)
            child.AncestryChanged:Connect(function()
                if HC.Jump == child and not child:IsDescendantOf(game) then
                    setJump(nil)
                end
            end)
        end
    end
    for _, child in ipairs(frame:GetChildren()) do
        check(child)
    end
    frame.ChildAdded:Connect(check)
end

local function tryTouchGui(gui)
    if not gui or gui.Name ~= "TouchGui" then
        return
    end
    task.spawn(function()
        local frame = gui:WaitForChild("TouchControlFrame", 10)
        if frame then
            watchTouchFrame(frame)
        end
    end)
end

