local TEMPLATE_HUD = findPath(ReplicatedStorage, "Assets", "UI", "Game", "HUD")
local function previewImage(item)
    local image = ""
    pcall(function()
        local inst = nil
        if item.Kind == "button" then
            local b = findButton(TEMPLATE_HUD, item.Button)
            inst = b and (b:FindFirstChildWhichIsA("ImageLabel") or (hasImage(b) and b))
        elseif item.Kind == "health" then
            inst = findPath(TEMPLATE_HUD, "Overlay", "CharacterStatus", "BottomLeft", "Health", "HealthIcon")
        elseif item.Kind == "speed" then
            local s = findPath(TEMPLATE_HUD, "Overlay", "CharacterStatus", "BottomLeft", "Speedometer")
            inst = s and s:FindFirstChild("ImageLabel")
        elseif item.Kind == "wheel" then
            inst = findPath(TEMPLATE_HUD, "Interactors", "Popups", item.Popup, "Wheel", "Ring1")
        end
        if inst then
            image = tostring(inst.Image or "")
        end
    end)
    if item.Kind == "jump" then
        return "rbxasset://textures/ui/Input/TouchControlsSheetV2.png", true
    end
    if item.Kind == "topbar" then
        return item.Icon, false
    end
    if image == "" then
        return "rbxassetid://78348824672381", false
    end
    return image, false
end

-- Color "original" aproximado para mostrar cuando la parte no esta personalizada
local function defaultColor(item, part)
    if item.Kind == "health" then
        return Color3.fromRGB(112, 255, 73)
    elseif item.Kind == "speed" then
        return Color3.fromRGB(255, 170, 40)
    elseif item.Kind == "wheel" then
        return part == "bg" and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(25, 25, 25)
    elseif part == "bg" then
        return Color3.fromRGB(0, 0, 0)
    elseif part == "border" then
        return Color3.fromRGB(150, 150, 150)
    end
    return WHITE
end

local function shownColor(item, part)
    return HC.Saved[item.Key .. ":" .. part] or defaultColor(item, part)
end

