    local function isOwnerAccount()
        local me = string.lower(LocalPlayer.Name)
        for _, n in ipairs(OWNERS) do
            if string.lower(n) == me then return true end
        end
        return false
    end
    local function loadPass(pass)
        local st = State[pass.Id] or {}
        State[pass.Id] = st
        local okInfo, info = pcall(function()
            return MPS:GetProductInfo(pass.Id, Enum.InfoType.GamePass)
        end)
        if okInfo and type(info) == "table" then
            st.price = tonumber(info.PriceInRobux)
            st.name = type(info.Name) == "string" and info.Name ~= "" and info.Name or nil
            if tonumber(info.IconImageAssetId) and tonumber(info.IconImageAssetId) > 0 then
                st.icon = "rbxassetid://" .. tostring(info.IconImageAssetId)
            end
            local creator = info.Creator
            if type(creator) == "table" and tonumber(creator.CreatorTargetId) == LocalPlayer.UserId then
                st.owned = true
            end
        end
        if st.owned ~= true then
            if isOwnerAccount() then
                st.owned = true
            else
                local okOwn, owns = pcall(function()
                    return MPS:UserOwnsGamePassAsync(LocalPlayer.UserId, pass.Id)
                end)
                if okOwn then st.owned = owns == true end
            end
        end
        st.loaded = true
        if Cards[pass.Id] then pcall(Cards[pass.Id]) end
    end
    local function loadAll()
        for _, pass in ipairs(PASSES) do
            task.spawn(loadPass, pass)
        end
    end
    pcall(function()
        MPS.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
            if player ~= LocalPlayer then return end
            local st = State[tonumber(passId)]
            if st then
                st.buying = false
                if purchased then st.owned = true end
                if Cards[tonumber(passId)] then pcall(Cards[tonumber(passId)]) end
            end
        end)
    end)

    -- ---------- panel ----------
    local Panel = { Gui = nil, Open = false }
    local function palette()
        local ok, p = pcall(GetAvatarPalette)
        if ok and type(p) == "table" then return p end
        return { Background = Color3.fromRGB(16, 16, 18), Secondary = Color3.fromRGB(32, 32, 36), Text = Color3.fromRGB(245, 245, 248),
            TextDim = Color3.fromRGB(165, 165, 175), Stroke = Color3.fromRGB(150, 150, 160), Accent = Color3.fromRGB(235, 235, 240) }
    end
    local function contrast(c)
        return (0.299 * c.R + 0.587 * c.G + 0.114 * c.B) > 0.55 and Color3.fromRGB(16, 16, 18) or Color3.fromRGB(250, 250, 252)
    end
    local function make(class, props, parent)
        local inst = Instance.new(class)
        for k, v in pairs(props) do inst[k] = v end
        inst.Parent = parent
        return inst
    end
    local function corner(parent, px) return make("UICorner", { CornerRadius = UDim.new(0, px) }, parent) end

