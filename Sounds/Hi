    -- ---------- PARED INVISIBLE (funciona también en Solara: no usa require) ----------
    local Wall = { On = false, Part = nil, Conn = nil, Tool = nil, HasGrapple = false, NextToolCheck = 0 }

    local function removeWall()
        if Wall.Part then pcall(function() Wall.Part:Destroy() end) end
        Wall.Part = nil
    end

    local function ensureWall()
        if Wall.Part then
            -- se reutiliza la misma pared (se oculta con Parent = nil); si algo la destruyó, se crea otra
            local ok = pcall(function() Wall.Part.Parent = Workspace end)
            if ok then return Wall.Part end
            Wall.Part = nil
        end
        local p = Instance.new("Part")
        p.Name = "YYGrappleWall"
        p.Size = Vector3.new(18, 18, 1)
        p.Anchored = true
        p.CanCollide = true      -- el tiro ignora partes con CanCollide = false
        p.CanQuery = true
        p.CanTouch = false
        p.CastShadow = false
        p.Material = Enum.Material.SmoothPlastic
        p.Transparency = 0.995   -- con 1 exacto el tiro la atraviesa
        p.Parent = Workspace     -- fuera de Effects / Players / Rigs (que el tiro ignora)
        Wall.Part = p
        return p
    end

    -- busca el gancho en la herramienta del rig visual (igual que hace el juego: partes Grapple / Grapple1 / Grapple2)
    local function grappleTool()
        local now = os.clock()
        if now < Wall.NextToolCheck then return Wall.HasGrapple and Wall.Tool or nil end
        Wall.NextToolCheck = now + 0.25
        Wall.HasGrapple, Wall.Tool = false, nil
        local rigs = Workspace:FindFirstChild("Rigs")
        local rig = rigs and rigs:FindFirstChild(LocalPlayer.Name)
        local tool = rig and rig:FindFirstChild("Tool")
        if tool then
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("BasePart") and (d.Name == "Grapple" or d.Name == "Grapple1" or d.Name == "Grapple2") then
                    Wall.HasGrapple, Wall.Tool = true, tool
                    break
                end
            end
        end
        return Wall.HasGrapple and Wall.Tool or nil
    end

    -- tu tiro en vuelo o enganchado (el juego lo pone en workspace.Effects.Ignore.Projectiles con Creator = tu Tag)
    local function myShot()
        local char = LocalPlayer.Character
        local tag = char and char:GetAttribute("Tag")
        local effects = Workspace:FindFirstChild("Effects")
        local ignore = effects and effects:FindFirstChild("Ignore")
        local folder = ignore and ignore:FindFirstChild("Projectiles")
        if not (folder and tag ~= nil) then return nil end
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == "Grapple" and child:GetAttribute("Creator") == tag then return child end
        end
        return nil
    end

    -- mismo raycast que el juego: excluye Effects/Players/Rigs, salta Transparency==1 o CanCollide==false
    local function castLikeGame(origin, direction)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local list = {}
        for _, name in ipairs({ "Effects", "Players", "Rigs" }) do
            local f = Workspace:FindFirstChild(name)
            if f then table.insert(list, f) end
        end
        if Wall.Part then table.insert(list, Wall.Part) end
        params.FilterDescendantsInstances = list
        pcall(function() params.CollisionGroup = "Raycast" end)
        for _ = 1, 16 do
            local hit = Workspace:Raycast(origin, direction, params)
            if not hit then return nil end
            if hit.Instance.Transparency ~= 1 and hit.Instance.CanCollide ~= false then return hit end
            table.insert(list, hit.Instance)
            params.FilterDescendantsInstances = list
        end
        return nil
    end

    local function wallStep()
        local tool = grappleTool()
        if not tool then
            if Wall.Part and Wall.Part.Parent then Wall.Part.Parent = nil end
            return
        end
        local shot = myShot()
        if shot or tool:GetAttribute("GrappleActive") then
            -- tiro en curso: la pared queda quieta; ya enganchado, deja de chocar contigo
            if Wall.Part and (shot == nil or shot:GetAttribute("Done") == true) then
                Wall.Part.CanCollide = false
                Wall.Part.CanQuery = false
            end
            return
        end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local camera = Workspace.CurrentCamera
        if not (hrp and camera) then return end
        local headPos = hrp:FindFirstChild("HeadPos")
        local origin = (headPos and headPos:IsA("Attachment")) and headPos.WorldPosition or (hrp.Position + Vector3.new(0, 1.5, 0))
        local look = camera.CFrame.LookVector
        local reach = STEP * (RangeCfg.Steps or 1) - WALL_MARGIN
        if castLikeGame(origin, look * reach) then
            -- hay algo real dentro del alcance: no hace falta pared
            if Wall.Part and Wall.Part.Parent then Wall.Part.Parent = nil end
            return
        end
        local part = ensureWall()
        part.CanCollide = true
        part.CanQuery = true
        local center = origin + look * reach
        part.CFrame = CFrame.lookAt(center, center + look)
        if part.Parent ~= Workspace then part.Parent = Workspace end
    end

    TabExtra:CreateToggle("Pared invisible al límite", "Invisible wall at max range", false, function(enabled)
        Wall.On = enabled
        if Wall.Conn then Wall.Conn:Disconnect() Wall.Conn = nil end
        if enabled then
            Wall.Conn = RunService.RenderStepped:Connect(function()
                local ok, err = pcall(wallStep)
                if not ok then warn("[Gancho] Pared: " .. tostring(err)) end
            end)
        else
            removeWall()
        end
    end)
